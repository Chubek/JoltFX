;; jolt.time — easing domain [0,1]; keyframes are [time value] pairs.
(module jolt.time)
(intrinsic fps->frame-time [number] -> f64)
(intrinsic frame-time->fps [number] -> f64)
(intrinsic seconds->frames [number number] -> f64)
(intrinsic frames->seconds [number number] -> f64)
(intrinsic keyframe-value [sequence number] -> f64)
(intrinsic ease-linear [number] -> f64)
(intrinsic ease-in-quad [number] -> f64)
(intrinsic ease-out-quad [number] -> f64)
(intrinsic ease-in-out-quad [number] -> f64)
(intrinsic ease-in-cubic [number] -> f64)
(intrinsic ease-out-cubic [number] -> f64)
(intrinsic ease-in-out-cubic [number] -> f64)
(intrinsic ease-in-quart [number] -> f64)
(intrinsic ease-out-quart [number] -> f64)
(intrinsic ease-in-out-quart [number] -> f64)
(intrinsic ease-in-quint [number] -> f64)
(intrinsic ease-out-quint [number] -> f64)
(intrinsic ease-in-out-quint [number] -> f64)
(intrinsic ease-in-sine [number] -> f64)
(intrinsic ease-out-sine [number] -> f64)
(intrinsic ease-in-out-sine [number] -> f64)
(intrinsic ease-in-expo [number] -> f64)
(intrinsic ease-out-expo [number] -> f64)
(intrinsic ease-in-out-expo [number] -> f64)
(intrinsic ease-in-circ [number] -> f64)
(intrinsic ease-out-circ [number] -> f64)
(intrinsic ease-in-out-circ [number] -> f64)
(intrinsic ease-in-elastic [number] -> f64)
(intrinsic ease-out-elastic [number] -> f64)
(intrinsic ease-in-out-elastic [number] -> f64)
(intrinsic ease-in-back [number] -> f64)
(intrinsic ease-out-back [number] -> f64)
(intrinsic ease-in-out-back [number] -> f64)
(intrinsic ease-in-bounce [number] -> f64)
(intrinsic ease-out-bounce [number] -> f64)
(intrinsic ease-in-out-bounce [number] -> f64)
(intrinsic linear-curve [number] -> f64)
(intrinsic bezier-curve [number number number number number] -> f64)
(intrinsic catmull-rom-curve [number number number number number] -> f64)
(intrinsic animate [number number function] -> f64)
