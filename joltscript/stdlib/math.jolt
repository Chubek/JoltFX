;; jolt.math — finite numeric operations and deterministic, closure-local random.
;; Intrinsic interfaces are checked by the compiler and embedded at build time.
(module jolt.math)
(intrinsic sin [number] -> f64)
(intrinsic cos [number] -> f64)
(intrinsic tan [number] -> f64)
(intrinsic asin [number] -> f64)
(intrinsic acos [number] -> f64)
(intrinsic atan [number] -> f64)
(intrinsic atan2 [number number] -> f64)
(intrinsic exp [number] -> f64)
(intrinsic log [number] -> f64)
(intrinsic log10 [number] -> f64)
(intrinsic log2 [number] -> f64)
(intrinsic exp2 [number] -> f64)
(intrinsic pow [number number] -> f64)
(intrinsic sqrt [number] -> f64)
(intrinsic cbrt [number] -> f64)
(intrinsic hypot [number number] -> f64)
(intrinsic floor [number] -> f64)
(intrinsic ceil [number] -> f64)
(intrinsic round [number] -> f64)
(intrinsic trunc [number] -> f64)
(intrinsic abs [number] -> f64)
(intrinsic sign [number] -> f64)
(intrinsic min [number number] -> f64)
(intrinsic max [number number] -> f64)
(intrinsic mod [number number] -> f64)
(intrinsic clamp [number number number] -> f64)
(intrinsic lerp [number number number] -> f64)
(intrinsic smoothstep [number number number] -> f64)
(intrinsic map-range [number number number number number] -> f64)
(intrinsic deg->rad [number] -> f64)
(intrinsic rad->deg [number] -> f64)
(intrinsic PI [] -> f64)
(intrinsic TWO-PI [] -> f64)
(intrinsic HALF-PI [] -> f64)
(intrinsic E [] -> f64)
(intrinsic SQRT2 [] -> f64)
(intrinsic SQRT1_2 [] -> f64)
(intrinsic random-seed [u32] -> function)
(intrinsic dot [sequence sequence] -> f64)
(intrinsic length [sequence] -> f64)
(intrinsic normalize [sequence] -> vector)
(intrinsic cross [sequence sequence] -> vector)
(intrinsic mat2-mul [sequence sequence] -> vector)
(intrinsic mat2-det [sequence] -> f64)
(intrinsic ease-in-quad [number] -> f64)
(intrinsic ease-out-quad [number] -> f64)
(intrinsic ease-in-out-quad [number] -> f64)
(intrinsic ease-in-cubic [number] -> f64)
(intrinsic ease-out-cubic [number] -> f64)
(intrinsic ease-in-out-cubic [number] -> f64)
(export *)
