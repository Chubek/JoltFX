;; jolt.strings — Unicode scalar indexing, ASCII case conversion, PCRE2 UTF regex.
(module jolt.strings)
(intrinsic str-length [string] -> i64)
(intrinsic str-empty? [string] -> bool)
(intrinsic str-not-empty? [string] -> bool)
(intrinsic str-trim [string] -> string)
(intrinsic str-trim-left [string] -> string)
(intrinsic str-trim-right [string] -> string)
(intrinsic str-upper [string] -> string)
(intrinsic str-lower [string] -> string)
(intrinsic str-capitalize [string] -> string)
(intrinsic str-replace [string string string] -> string)
(intrinsic str-replace-all [string string string] -> string)
(intrinsic str-split [string string] -> vector)
(intrinsic str-join [string sequence] -> string)
(intrinsic str-concat [& string] -> string)
(intrinsic str-contains? [string string] -> bool)
(intrinsic str-starts-with? [string string] -> bool)
(intrinsic str-ends-with? [string string] -> bool)
(intrinsic parse-int [string] -> i64)
(intrinsic parse-float [string] -> f64)
(intrinsic parse-bool [string] -> bool)
(intrinsic format [string & value] -> string)
(intrinsic format-int [value] -> string)
(intrinsic format-float [number i32] -> string)
(intrinsic char-at [string i64] -> char)
(intrinsic substring [string i64 i64] -> string)
(intrinsic str-reverse [string] -> string)
(intrinsic str-repeat [string i64] -> string)
(intrinsic str-pad-left [string i64 string] -> string)
(intrinsic str-pad-right [string i64 string] -> string)
(intrinsic whitespace? [char] -> bool)
(intrinsic str-compare [string string] -> i32)
(intrinsic str-equals? [string string] -> bool)
(intrinsic str-less? [string string] -> bool)
(intrinsic str-greater? [string string] -> bool)
(intrinsic regex-match? [string string] -> bool)
(intrinsic regex-find [string string] -> value)
(intrinsic regex-replace [string string string] -> string)
(export *)
