;; jolt.geometry — row-major matrices; quaternion order [x y z w]; radians.
(module jolt.geometry)
(intrinsic point2d [number number] -> vector)
(intrinsic point2d-x [sequence] -> f64)
(intrinsic point2d-y [sequence] -> f64)
(intrinsic point2d-add [sequence sequence] -> vector)
(intrinsic point2d-sub [sequence sequence] -> vector)
(intrinsic point2d-scale [sequence number] -> vector)
(intrinsic point2d-dist [sequence sequence] -> f64)
(intrinsic point2d-lerp [sequence sequence number] -> vector)
(intrinsic point3d [number number number] -> vector)
(intrinsic point3d-x [sequence] -> f64)
(intrinsic point3d-y [sequence] -> f64)
(intrinsic point3d-z [sequence] -> f64)
(intrinsic point3d-add [sequence sequence] -> vector)
(intrinsic point3d-sub [sequence sequence] -> vector)
(intrinsic point3d-scale [sequence number] -> vector)
(intrinsic point3d-dist [sequence sequence] -> f64)
(intrinsic point3d-lerp [sequence sequence number] -> vector)
(intrinsic vec2 [number number] -> vector)
(intrinsic vec3 [number number number] -> vector)
(intrinsic vec4 [number number number number] -> vector)
(intrinsic vec-dot [sequence sequence] -> f64)
(intrinsic vec-length [sequence] -> f64)
(intrinsic vec-normalize [sequence] -> vector)
(intrinsic vec-cross [sequence sequence] -> vector)
(intrinsic vec-lerp [sequence sequence number] -> vector)
(intrinsic translate2d [sequence number number] -> vector)
(intrinsic scale2d [sequence number number] -> vector)
(intrinsic rotate2d [sequence number] -> vector)
(intrinsic translate3d [sequence number number number] -> vector)
(intrinsic scale3d [sequence number number number] -> vector)
(intrinsic rotate3d-x [sequence number] -> vector)
(intrinsic rotate3d-y [sequence number] -> vector)
(intrinsic rotate3d-z [sequence number] -> vector)
(intrinsic mat-mul [sequence sequence i32] -> vector)
(intrinsic mat-transpose [sequence i32] -> vector)
(intrinsic quat [number number number number] -> vector)
(intrinsic quat-identity [] -> vector)
(intrinsic quat-mul [sequence sequence] -> vector)
(intrinsic quat-normalize [sequence] -> vector)
(intrinsic quat-from-axis-angle [sequence number] -> vector)
(intrinsic quat-rotate [sequence sequence] -> vector)
(intrinsic catmull-rom-spline [sequence sequence sequence sequence number] -> vector)
(intrinsic bezier-spline [sequence sequence sequence sequence number] -> vector)
(intrinsic bbox2d [sequence] -> vector)
(intrinsic bbox3d [sequence] -> vector)
(intrinsic point-in-bbox2d [sequence sequence] -> bool)
(intrinsic point-in-bbox3d [sequence sequence] -> bool)
(export *)
