;; jolt.graphics — RGB in [0,1], hue in turns; straight-alpha source-over.
(module jolt.graphics)
(intrinsic rgb->hsv [number number number] -> vector)
(intrinsic hsv->rgb [number number number] -> vector)
(intrinsic rgb->hsl [number number number] -> vector)
(intrinsic hsl->rgb [number number number] -> vector)
(intrinsic brightness [number number number number] -> vector)
(intrinsic contrast [number number number number] -> vector)
(intrinsic saturation [number number number number] -> vector)
(intrinsic invert [number number number number] -> vector)
(intrinsic grayscale [number number number] -> vector)
(intrinsic sepia [number number number] -> vector)
(intrinsic blend-normal [number number] -> f64)
(intrinsic blend-multiply [number number] -> f64)
(intrinsic blend-screen [number number] -> f64)
(intrinsic blend-overlay [number number] -> f64)
(intrinsic blend-darken [number number] -> f64)
(intrinsic blend-lighten [number number] -> f64)
(intrinsic blend-difference [number number] -> f64)
(intrinsic alpha-composite [number number number number number number number number] -> vector)
(intrinsic color-temperature [number number number number] -> vector)
(intrinsic gamma-correct [number number number number] -> vector)
(intrinsic gamma-decode [number number number] -> vector)
(intrinsic gamma-encode [number number number] -> vector)
;; CPU filter primitives: finite samples and weights, normalized by weight sum.
(intrinsic convolve [sequence sequence] -> f64)
(intrinsic box-filter [sequence] -> f64)
(intrinsic gaussian-weight [number number] -> f64)
(export *)
