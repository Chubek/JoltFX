;; jolt.collections — immutable, insertion-ordered collections; bounded sequences.
(module jolt.collections)
(intrinsic list [& value] -> list)
(intrinsic vector [& value] -> vector)
(intrinsic hash-map [& value] -> map)
(intrinsic set [& value] -> set)
(intrinsic length [value] -> i64)
(intrinsic empty? [value] -> bool)
(intrinsic not-empty? [value] -> bool)
(intrinsic nth [sequence i64] -> value)
(intrinsic first [sequence] -> value)
(intrinsic rest [sequence] -> vector)
(intrinsic last [sequence] -> value)
(intrinsic butlast [sequence] -> vector)
(intrinsic slice [sequence i64 ? i64] -> vector)
(intrinsic concat [& sequence] -> vector)
(intrinsic take [i64 value] -> vector)
(intrinsic drop [i64 value] -> value)
(intrinsic take-while [function sequence] -> vector)
(intrinsic drop-while [function sequence] -> vector)
(intrinsic partition [i64 sequence] -> vector)
(intrinsic partition-all [i64 sequence] -> vector)
(intrinsic interpose [value sequence] -> vector)
(intrinsic interleave [& sequence] -> vector)
(intrinsic zipmap [sequence sequence] -> map)
(intrinsic frequencies [sequence] -> map)
(intrinsic group-by [function sequence] -> map)
(intrinsic vec-get [sequence i64] -> value)
(intrinsic vec-set [sequence i64 value] -> vector)
(intrinsic vec-push [sequence value] -> vector)
(intrinsic vec-pop [sequence] -> vector)
(intrinsic vec-peek [sequence] -> value)
(intrinsic get [map value ? value] -> value)
(intrinsic assoc [map value value] -> map)
(intrinsic dissoc [map value] -> map)
(intrinsic map-get [map value ? value] -> value)
(intrinsic map-get-in [map sequence] -> value)
(intrinsic map-keys [map] -> vector)
(intrinsic map-vals [map] -> vector)
(intrinsic map-merge [& map] -> map)
(intrinsic map-invert [map] -> map)
(intrinsic set-union [sequence sequence] -> set)
(intrinsic set-intersection [sequence sequence] -> set)
(intrinsic set-difference [sequence sequence] -> set)
(intrinsic contains? [value value] -> bool)
(intrinsic range-seq [i64 i64 ? i64] -> function)
(intrinsic lazy-seq [function] -> function)
(intrinsic iterate [function value] -> function)
(intrinsic repeatedly [function] -> function)
(intrinsic cycle [sequence] -> function)
(intrinsic map [function sequence & sequence] -> vector)
(intrinsic map-indexed [function sequence] -> vector)
(intrinsic filter [function sequence] -> vector)
(intrinsic keep [function sequence] -> vector)
(intrinsic remove [function sequence] -> vector)
(intrinsic reduce [function value sequence] -> value)
(intrinsic reduce-kv [function value map] -> value)
(intrinsic apply [function sequence] -> value)
(intrinsic apply-kv [function map] -> value)
(intrinsic some [function sequence] -> bool)
(intrinsic every? [function sequence] -> bool)
(intrinsic sort [sequence function] -> vector)
(export *)
