// A procedural 1026-primitive scene, well above the original 256 limit.
fn main() {
 trace_camera(vec3(0.0, 12.0, 20.0), vec3(0.0, 0.0, -0.3), vec3(0.0, 1.0, 0.0), 45.0);
 trace_sky(vec3(0.65, 0.75, 0.9), vec3(0.1, 0.25, 0.55));
 trace_light(vec3(-1.0, 3.0, 2.0), 1.8);
 let row = 0;
 while row < 32 {
  let column = 0;
  while column < 32 {
   let center = vec3((column - 15.5) * 0.55, 0.0, (row - 15.5) * 0.55);
   if (row + column) % 2 == 0 {
    trace_sphere(center, 0.22, vec3(0.8, 0.15, 0.08), 0.1, 0.0);
   } else {
    trace_sphere(center, 0.22, vec3(0.85, 0.9, 0.95), 0.65, 0.0);
   }
   column += 1;
  }
  row += 1;
 }
 trace_triangle(vec3(-20.0, -0.22, -20.0), vec3(20.0, -0.22, -20.0), vec3(20.0, -0.22, 20.0), vec3(0.4, 0.45, 0.35), 0.0, 0.0);
 trace_triangle(vec3(-20.0, -0.22, -20.0), vec3(20.0, -0.22, 20.0), vec3(-20.0, -0.22, 20.0), vec3(0.4, 0.45, 0.35), 0.0, 0.0);
}
