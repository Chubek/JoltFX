 trace_sphere(vec3(1.2, 0.0, -1.5), 1.0, vec3(0.85, 0.9, 0.95), 0.85, 0.0);
 trace_triangle(vec3(-20.0, -1.0, -20.0), vec3(20.0, -1.0, -20.0), vec3(20.0, -1.0, 20.0), vec3(0.5, 0.55, 0.45), 0.05, 0.0);
 trace_triangle(vec3(-20.0, -1.0, -20.0), vec3(20.0, -1.0, 20.0), vec3(-20.0, -1.0, 20.0), vec3(0.5, 0.55, 0.45), 0.05, 0.0);
