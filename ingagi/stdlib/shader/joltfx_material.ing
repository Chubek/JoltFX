// std.shader binding for the JoltFX 3D tab (material/shading control).
// The 3D renderer is a CPU z-buffered rasterizer with per-object RGB
// materials and smooth/flat normals; Ingagi drives it numerically through
// engine_scene_color/procedural. Full GPU shader compilation stays in
// `ingagi/shader` (GLSL 450 -> SPIR-V -> HLSL/MSL/WGSL); this file is the
// script-side material companion for the viewport.
// Host callbacks: engine_scene_color(object, channel 0..2, value 0..1),
// engine_scene_procedural(object, field).

// Set an RGB material in one call.
fn shader_material(object: i64, r: f64, g: f64, b: f64) {
    engine_scene_color(object, 0, r);
    engine_scene_color(object, 1, g);
    engine_scene_color(object, 2, b);
}

// Lerp a material from c0 to c1 across `steps` frames on one channel ramp.
// Used to preview shader-like gradients without a GPU program.
fn shader_ramp(object: i64, channel: i64, v0: f64, v1: f64, start_frame: i64, end_frame: i64) {
    engine_scene_key(object, channel, start_frame, v0);
    engine_scene_key(object, channel, end_frame, v1);
}

// Return 1 when the object uses smooth shading, else 0.
fn shader_is_smooth(object: i64) -> i64 {
    return engine_scene_procedural(object, 3);
}

fn main() -> i64 {
    let object = engine_scene_add(0);
    shader_material(object, 0.32, 0.65, 0.9);
    shader_ramp(object, 0, -2.0, 2.0, 0, 60);
    return shader_is_smooth(object);
}
