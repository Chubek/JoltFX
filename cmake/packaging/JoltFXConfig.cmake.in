@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@JFX_PACKAGE_VULKAN@)
    find_dependency(Vulkan)
endif()
if(@JFX_PACKAGE_SDL2@)
    find_dependency(SDL2)
endif()
if(@JFX_PACKAGE_OPENGL@)
    find_dependency(OpenGL COMPONENTS OpenGL)
endif()
if(@JFX_PACKAGE_OCIO@)
    find_dependency(OpenColorIO 2 CONFIG)
endif()
if(@JFX_PACKAGE_FFMPEG@ AND NOT TARGET PkgConfig::JFX_FFMPEG)
    find_dependency(PkgConfig)
    pkg_check_modules(JFX_FFMPEG REQUIRED IMPORTED_TARGET
        libavformat libavcodec libavutil libswscale libswresample)
endif()
if(@JFX_PACKAGE_WASMTIME@)
    set(_JoltFX_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Wasmtime 38)
    set(CMAKE_MODULE_PATH "${_JoltFX_module_path}")
    unset(_JoltFX_module_path)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/JoltFXTargets.cmake")
check_required_components(JoltFX)
