;; @kernel       freeze_frame
;; @category     time
;; @description  Outputs a chosen source frame unchanged for the selected time range.
;; @complexity   Low
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.time; shared functions: common/image.jolt.
;; frame index to hold; range [0, 9999].
(param frame_index 0 0 9999 1)
;; start time; range [0, 1000].
(param start_time 0 0 1000 0)
;; end time; range [0, 1000].
(param end_time 1000 0 1000 0)


(defkernel freeze_frame [x y c]
  (pixel x y c))