;; @kernel       time_remap
;; @category     time
;; @description  Maps output time to a source-frame time using a configurable time curve.
;; @complexity   Medium
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.time; shared functions: common/image.jolt.
;; The resource array holds the frame history, each frame width*height*4 floats.
;; normalized source time [0,1]; range [0, 1].
(param time 0.5 0 1 0)
;; mapping curve; 0 linear, 1 smooth, 2 ease-in, 3 ease-out; range [0, 3].
(param mapping 0 0 3 1)
;; interpolation; 0 nearest, 1 linear; range [0, 1].
(param interpolation 1 0 1 1)
;; boundary mode; 0 hold, 1 wrap, 2 mirror; range [0, 2].
(param boundary_mode 0 0 2 1)


(defkernel time_remap [x y c]
  (let [fs (* 4 (* width height))
        nf (if (= fs 0) 0 (floor (/ (data-count) fs)))]
    (if (= nf 0) (pixel x y c)
      (let [t (if (= mapping 0) time
                (if (= mapping 1) (smooth 0 1 time)
                  (if (= mapping 2) (* time time) (- 1 (* (- 1 time) (- 1 time))))))
            pos (* t (- nf 1))
            i0 (floor pos)
            i1 (min (- nf 1) (+ i0 1))
            f (- pos i0)
            idx (+ (* 4 (+ (* y width) x)) c)
            a (data (+ (* i0 fs) idx))
            b (data (+ (* i1 fs) idx))]
        (if (= interpolation 0) a (mix a b f))))))
