;; @kernel       motion_trail
;; @category     time
;; @description  Composites earlier frames with decreasing weights to create a motion trail.
;; @complexity   Medium
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.time; shared functions: common/image.jolt.
;; The resource array holds the frame history, each frame width*height*4 floats.
;; trail length in frames; range [1, 60].
(param length 8 1 60 1)
;; decay factor per frame; range [0, 1].
(param decay 0.5 0 1 0)
;; blend mode; 0 lighten, 1 add, 2 screen; range [0, 2].
(param blend_mode 0 0 2 1)
;; direction; 0 oldest first, 1 newest first; range [0, 1].
(param direction 0 0 1 1)


(defkernel motion_trail [x y c]
  (let [fs (* 4 (* width height))
        nf (if (= fs 0) 0 (floor (/ (data-count) fs)))]
    (if (= nf 0) (pixel x y c)
      (let [n (min length nf)
            idx (+ (* 4 (+ (* y width) x)) c)
            total (sum k 0 n
                    (let [w (pow decay k)
                          f (if (= direction 0) k (- nf 1 k))]
                      (* w (data (+ (* f fs) idx)))))
            wsum (max .0001 (sum k 0 n (pow decay k)))
            v (/ total wsum)
            base (pixel x y c)]
        (if (= blend_mode 0) (max base v)
          (if (= blend_mode 1) (min 1 (+ base v)) (blend-screen base v)))))))
