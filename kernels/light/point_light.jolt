;; @kernel       point_light
;; @category     light
;; @description  Illuminates a frame from a position with distance attenuation.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.light; shared functions: common/image.jolt.
;; light position x in normalized coordinates; range [-2, 2].
(param position_x 0.5 -2 2 0)
;; light position y in normalized coordinates; range [-2, 2].
(param position_y 0.5 -2 2 0)
;; light color red; range [0, 1].
(param color_r 1 0 1 0)
;; light color green; range [0, 1].
(param color_g 1 0 1 0)
;; light color blue; range [0, 1].
(param color_b 1 0 1 0)
;; light intensity; range [0, 4].
(param intensity 1 0 4 0)
;; light radius in normalized coordinates; range [0.01, 2].
(param radius 0.5 0.01 2 0)
;; falloff exponent; range [0.5, 4].
(param falloff 2 0.5 4 0)


(defkernel point_light [x y c]
  (if (= c 3) (pixel x y 3)
    (pixel x y c)))