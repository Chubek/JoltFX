;; @kernel       keying_garbage_matte
;; @category     keying
;; @description  Applies garbage matte to remove unwanted areas.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.keying; shared functions: common/image.jolt.
;; invert matte; range [0, 1].
(param invert 0 0 1 1)
;; feather in pixels; range [0, 64].
(param feather 2 0 64 0)


(defkernel keying_garbage_matte [x y c]
  (let [r (ceil feather)
        m (if (= (data-count) 0) 1 (data (+ (* 4 (+ (* y width) x)) 0)))
        m0 (if (or (= r 0) (= (data-count) 0)) m
             (/ (sum i (- r) (+ r 1) (sum j (- r) (+ r 1)
                  (data (+ (* 4 (+ (* (max 0 (min (- height 1) (+ y j))) width) (max 0 (min (- width 1) (+ x i))))) 0))))
                (* (+ (* 2 r) 1) (+ (* 2 r) 1))))
        a (if (= invert 1) (- 1 m0) m0)]
    (if (= c 3) (* (pixel x y 3) a) (* (straight x y c) a))))
