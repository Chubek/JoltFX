;; @kernel       keying_chroma_keyer
;; @category     keying
;; @description  Keys out based on chroma values.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst with keyed alpha, same dimensions.
;; Module: jolt.fx.kernels.keying; shared functions: common/image.jolt.
;; key color red; range [0, 1].
(param key_color_r 0 0 1 0)
;; key color green; range [0, 1].
(param key_color_g 1 0 1 0)
;; key color blue; range [0, 1].
(param key_color_b 0 0 1 0)
;; tolerance; range [0, 1].
(param tolerance 0.2 0 1 0)
;; softness; range [0, 1].
(param softness 0.1 0 1 0)
;; despill; range [0, 1].
(param despill 1 0 1 1)


(defkernel keying_chroma_keyer [x y c]
  (let [r (straight x y 0)
        g (straight x y 1)
        b (straight x y 2)
        l (luma r g b)
        cr (- r l)
        cg (- g l)
        cb (- b l)
        kr (- key_color_r (luma key_color_r key_color_g key_color_b))
        kg (- key_color_g (luma key_color_r key_color_g key_color_b))
        kb (- key_color_b (luma key_color_r key_color_g key_color_b))
        d (sqrt (+ (* (- cr kr) (- cr kr)) (* (- cg kg) (- cg kg)) (* (- cb kb) (- cb kb))))
        a (clamp01 (/ (- d tolerance) (max softness .0001)))
        v (if (= despill 1) (- (channel c r g b) (* 0.5 (- 1 a) (channel c kr kg kb))) (channel c r g b))]
    (if (= c 3) a (* v a))))
