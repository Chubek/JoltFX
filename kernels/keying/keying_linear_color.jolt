;; @kernel       keying_linear_color
;; @category     keying
;; @description  Keys using linear color keying.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst with keyed alpha, same dimensions.
;; Module: jolt.fx.kernels.keying; shared functions: common/image.jolt.
;; Distance is measured in linear light rather than gamma-encoded values, so the key
;; matches consistently across the tonal range instead of only in the midtones.
;; key color red; range [0, 1].
(param key_color_r 0 0 1 0)
;; key color green; range [0, 1].
(param key_color_g 1 0 1 0)
;; key color blue; range [0, 1].
(param key_color_b 0 0 1 0)
;; tolerance; range [0, 1].
(param tolerance 0.15 0 1 0)
;; edge softness; range [0, 1].
(param softness 0.1 0 1 0)
;; despill amount; range [0, 1].
(param despill 0.5 0 1 0)


(defkernel keying_linear_color [x y c]
  (let [lr (decode (straight x y 0))
        lg (decode (straight x y 1))
        lb (decode (straight x y 2))
        kr (decode key_color_r)
        kg (decode key_color_g)
        kb (decode key_color_b)
        dr (- lr kr)
        dg (- lg kg)
        db (- lb kb)
        ;; green carries most of the perceptual weight, so it dominates the metric
        d (sqrt (+ (* 0.5 (* dr dr)) (* 1.0 (* dg dg)) (* 0.5 (* db db))))
        a (clamp01 (/ (- d tolerance) (max softness .0001)))
        v (if (= despill 0) (straight x y c)
            (- (straight x y c)
               (* despill (- 1 a) (channel c key_color_r key_color_g key_color_b))))]
    (if (= c 3) a (* v a))))
