;; @kernel       comp_layer_warp_stabilize
;; @category     compositing
;; @description  Applies warp stabilization to layer.
;; @complexity   High
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (the layer at the current time, premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.compositing; shared functions: common/image.jolt.
;; The resource array packs a frame window as RGBA frames of width*height*4 floats
;; back to back, read through `warp-frame`, which returns the source pixel for an
;; index the window does not cover, so an absent window leaves the layer untouched
;; apart from the crop zoom. Warp stabilisation differs from a rigid stabilise in
;; what it smooths: instead of one global shift it builds a smooth per-pixel
;; transform field. The rigid part is the usual luma-weighted centroid distance
;; between the current frame and the triangularly weighted centroid of the window,
;; measured on a 2x2 luma quadrature. The residual part is a per-pixel
;; Lucas-Kanade flow between the source and the newest window frame on a 3x3
;; gradient patch, so parallax and slow rolling motion survive as a smooth warp
;; rather than being thrown away with the camera shake. `smoothing` blends the warp
;; field from fully per-pixel at 0 to fully rigid at 1, which is the knob that turns
;; a warp stabiliser into a plain stabiliser. `method` selects what the rigid part
;; compensates; the profile has no string type, so a named method is an integer code:
;; 0 translation only, 1 translation plus the apparent scale taken from the ratio of
;; the window's mean spread to the current frame's spread, which locks a zoom as
;; well as a pan. `crop` zooms the sampling window about the frame centre to hide
;; the border the warp exposes, and `window` is the number of frames the smoothed
;; rigid path is averaged over.
;; blend from a per-pixel warp field to a rigid shift; range [0, 1].
(param smoothing 0.5 0 1 0)
;; extra zoom about the frame centre that hides the exposed border; range [0, 0.6].
(param crop 0.15 0 0.6 0)
;; rigid compensation method; 0 translation, 1 translation and scale; range [0, 1].
(param method 0 0 1 1)
;; number of frames the smoothed rigid path is averaged over; range [1, 3].
(param window 3 1 3 1)


;; Frame k of the packed window, or the source pixel when the window is short.
(defn warp-frame [nf k ch px py]
  (if (all2 (> nf 1) (all2 (>= k 0) (< k nf)))
    (data (+ (* k (* 4 (* width height))) ch (* 4 (+ (* py width) px))))
    (pixel px py ch)))


;; Straight Rec.709 luminance of the source at a clamped offset.
(defn warp-ls [px py]
  (let [qx (min (- width 1) (max 0 px)) qy (min (- height 1) (max 0 py))
        a (pixel qx qy 3)]
    (if (> a 0) (/ (luma (pixel qx qy 0) (pixel qx qy 1) (pixel qx qy 2)) a) 0)))


;; Straight Rec.709 luminance of window frame k at a clamped offset.
(defn warp-lf [nf k px py]
  (let [qx (min (- width 1) (max 0 px)) qy (min (- height 1) (max 0 py))
        a (warp-frame nf k 3 qx qy)]
    (if (> a 0) (/ (luma (warp-frame nf k 0 qx qy) (warp-frame nf k 1 qx qy)
                         (warp-frame nf k 2 qx qy)) a) 0)))


;; Premultiplied Rec.709 luma of window frame k at a clamped position.
(defn warp-w [nf k px py]
  (let [qx (min (- width 1) (max 0 px)) qy (min (- height 1) (max 0 py))]
    (luma (warp-frame nf k 0 qx qy) (warp-frame nf k 1 qx qy) (warp-frame nf k 2 qx qy))))


;; Luma-weighted x centroid moment of frame k over the quadrature.
(defn warp-cxm [nf k a b]
  (sum j 0 2 (sum i 0 2
    (* (warp-w nf k (if (= i 0) a b) (if (= j 0) a b)) (if (= i 0) a b)))))


;; Luma-weighted y centroid moment of frame k over the quadrature.
(defn warp-cym [nf k a b]
  (sum j 0 2 (sum i 0 2
    (* (warp-w nf k (if (= i 0) a b) (if (= j 0) a b)) (if (= j 0) a b)))))


;; Luma-weighted second moment of frame k about the frame centre.
(defn warp-msm [nf k a b]
  (sum j 0 2 (sum i 0 2
    (let [px (if (= i 0) a b) py (if (= j 0) a b)]
      (* (warp-w nf k px py) (+ (* (- px a) (- px a)) (* (- py a) (- py a))))))))


(defkernel comp_layer_warp_stabilize [x y c]
  (let [fs (max 1 (* 4 (* width height)))
        nf (max 0 (floor (/ (data-count) fs)))
        cx0 (/ (- width 1) 2)
        qx0 (/ width 4) qx1 (* .75 width) qy0 (/ height 4) qy1 (* .75 height)
        kc (max 0 (- nf 1))
        lo (max 0 (- kc (- window 1)))
        cnt (+ 1 (- kc lo))
        ;; the rigid part: window moments on the 2x2 quadrature
        wm (if (> nf 0) (sum j 0 cnt (sum i 0 2 (sum h 0 2
          (warp-w nf (+ lo j) (if (= i 0) qx0 qx1) (if (= h 0) qy0 qy1))))) 0)
        smx (if (> nf 0) (sum j 0 cnt (* (- cnt j) (warp-cxm nf (+ lo j) qx0 qx0))) 0)
        smy (if (> nf 0) (sum j 0 cnt (* (- cnt j) (warp-cym nf (+ lo j) qx0 qx0))) 0)
        cm (if (> nf 0) (max .000001 (sum i 0 2 (sum h 0 2
          (warp-w nf kc (if (= i 0) qx0 qx1) (if (= h 0) qy0 qy1))))) 1)
        gdx (if (> nf 0) (- (/ (warp-cxm nf kc qx0 qx0) cm)
                           (if (> wm 0) (/ smx wm) (/ (warp-cxm nf kc qx0 qx0) cm))) 0)
        gdy (if (> nf 0) (- (/ (warp-cym nf kc qx0 qx0) cm)
                           (if (> wm 0) (/ smy wm) (/ (warp-cym nf kc qx0 qx0) cm))) 0)
        ;; the residual part: per-pixel Lucas-Kanade flow over a 3x3 patch
        ix0 (- (warp-ls (- x 1) (- y 1)) (warp-ls (- x 1) (+ y 1)))
        ix1 (- (warp-ls x (- y 1)) (warp-ls x (+ y 1)))
        ix2 (- (warp-ls (+ x 1) (- y 1)) (warp-ls (+ x 1) (+ y 1)))
        iy0 (- (warp-ls (- x 1) (- y 1)) (warp-ls (+ x 1) (- y 1)))
        iy1 (- (warp-ls (- x 1) y) (warp-ls (+ x 1) y))
        iy2 (- (warp-ls (- x 1) (+ y 1)) (warp-ls (+ x 1) (+ y 1)))
        jx0 (- (warp-lf nf kc (- x 1) (- y 1)) (warp-lf nf kc (- x 1) (+ y 1)))
        jx1 (- (warp-lf nf kc x (- y 1)) (warp-lf nf kc x (+ y 1)))
        jx2 (- (warp-lf nf kc (+ x 1) (- y 1)) (warp-lf nf kc (+ x 1) (+ y 1)))
        jy0 (- (warp-lf nf kc (- x 1) (- y 1)) (warp-lf nf kc (+ x 1) (- y 1)))
        jy1 (- (warp-lf nf kc (- x 1) y) (warp-lf nf kc (+ x 1) y))
        jy2 (- (warp-lf nf kc (- x 1) (+ y 1)) (warp-lf nf kc (+ x 1) (+ y 1)))
        aa (+ (* ix0 ix0) (* ix1 ix1) (* ix2 ix2))
        ab (+ (* ix0 iy0) (* ix1 iy1) (* ix2 iy2))
        bb (+ (* iy0 iy0) (* iy1 iy1) (* iy2 iy2))
        det (- (* aa bb) (* ab ab))
        ta (+ (* ix0 (- ix0 jx0)) (* ix1 (- ix1 jx1)) (* ix2 (- ix2 jx2)))
        tb (+ (* iy0 (- iy0 jy0)) (* iy1 (- iy1 jy1)) (* iy2 (- iy2 jy2)))
        good (all2 (> nf 0) (> (abs det) .000001))
        lfx (if good (/ (- (* bb ta) (* ab tb)) det) 0)
        lfy (if good (/ (- (* aa tb) (* ab ta)) det) 0)
        ;; blend the warp field from per-pixel to rigid
        wfx (- (* smoothing gdx) (* (- 1 smoothing) lfx))
        wfy (- (* smoothing gdy) (* (- 1 smoothing) lfy))
        ;; optional rigid scale compensation from the spread ratio
        sc (if (all2 (= method 1) (> nf 0))
             (let [cw (if (> wm 0) wm 1)
                   cm2 (max .000001 (sum i 0 2 (sum h 0 2
                     (warp-w nf kc (if (= i 0) qx0 qx1) (if (= h 0) qy0 qy1)))))
                   cms (max .000001 (warp-msm nf kc qx0 qx0))
                   sms (sum j 0 cnt (* (- cnt j) (warp-msm nf (+ lo j) qx0 qx0)))]
               (max .25 (min 4 (/ (sqrt (/ sms cw)) (sqrt (/ cms cm2))))))
             1)
        zoom (* (+ 1 crop) (max .25 (min 4 sc)))
        ux (+ cx0 (* zoom (- x cx0)) wfx)
        uy (+ cx0 (* zoom (- y cx0)) wfy)]
    (sample ux uy c 1 1)))