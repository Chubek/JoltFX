;; @kernel       cross_dissolve
;; @category     transition
;; @description  Interpolates two frames over time for a smooth dissolve transition.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (from frame); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.transition; shared functions: common/image.jolt.
;; The resource array holds the destination frame, width*height*4 floats.
;; progress [0,1]; range [0, 1].
(param progress 0.5 0 1 0)
;; easing curve; 0 linear, 1 smooth, 2 ease-in, 3 ease-out; range [0, 3].
(param curve 0 0 3 1)
;; 0 straight, 1 premultiplied; range [0, 1].
(param premultiplied 1 0 1 1)


(defkernel cross_dissolve [x y c]
  (let [p (if (= curve 0) progress
            (if (= curve 1) (smooth 0 1 progress)
              (if (= curve 2) (* progress progress) (- 1 (* (- 1 progress) (- 1 progress))))))]
    (mix (pixel x y c) (to-frame x y c) p)))
