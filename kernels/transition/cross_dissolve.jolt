;; @kernel       cross_dissolve
;; @category     transition
;; @description  Interpolates two frames over time for a smooth dissolve transition.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.transition; shared functions: common/image.jolt.
;; progress [0,1]; range [0, 1].
(param progress 0.5 0 1 0)
;; easing curve; 0 linear, 1 smooth, 2 ease-in, 3 ease-out; range [0, 3].
(param curve 0 0 3 1)
;; 0 from frame, 1 to frame; using data for to frame; range [0, 1].
(param use_data 0 0 1 1)
;; 0 transparent, 1 clamp, 2 wrap, 3 mirror; range [0, 3].
(param border_mode 1 0 3 1)


(defkernel cross_dissolve [x y c]
  (if (= c 3) (pixel x y 3)
    (pixel x y c)))