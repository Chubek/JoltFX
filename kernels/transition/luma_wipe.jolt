;; @kernel       luma_wipe
;; @category     transition
;; @description  Reveals a destination frame according to a luminance map.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.transition; shared functions: common/image.jolt.
;; progress [0,1]; range [0, 1].
(param progress 0.5 0 1 0)
;; 0 from frame, 1 to frame (using data); range [0, 1].
(param use_data 0 0 1 1)
;; softness of edge; range [0, 1].
(param softness 0.1 0 1 0)
;; invert; range [0, 1].
(param invert 0 0 1 1)


(defkernel luma_wipe [x y c]
  (if (= c 3) (pixel x y 3)
    (pixel x y c)))