;; @kernel       wipe
;; @category     transition
;; @description  Reveals a destination frame across a directional boundary.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (from frame); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.transition; shared functions: common/image.jolt.
;; The resource array holds the destination frame, width*height*4 floats.
;; progress [0,1]; range [0, 1].
(param progress 0.5 0 1 0)
;; direction angle in degrees; range [0, 360].
(param direction 0 0 360 0)
;; softness of edge; range [0, 1].
(param softness 0.1 0 1 0)


(defkernel wipe [x y c]
  (let [ang (radians direction)
        nx (cos ang)
        ny (sin ang)
        bx (+ (* (- (/ x width) .5) nx) (* (- (/ y height) .5) ny))
        edge (- (* progress 2) 1)
        diff (- bx edge)
        p (if (< softness .0001) (if (< diff 0) 0 1) (clamp01 (+ .5 (/ diff softness))))]
    (mix (pixel x y c) (to-frame x y c) p)))
