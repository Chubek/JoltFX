;; @kernel       cube_flip
;; @category     transition
;; @description  Transitions between frames with a simulated rotating cube-face effect.
;; @complexity   High
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (from frame); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.transition; shared functions: common/image.jolt.
;; The resource array holds the destination frame, width*height*4 floats.
;; progress in [0,1]; range [0, 1].
(param progress 0.5 0 1 0)
;; rotation axis x; range [-1, 1].
(param axis_x 0 -1 1 0)
;; rotation axis y; range [-1, 1].
(param axis_y 1 -1 1 0)
;; rotation axis z; range [-1, 1].
(param axis_z 0 -1 1 0)
;; perspective depth; range [0.1, 10].
(param perspective 1 0.1 10 0)
;; background color red; range [0, 1].
(param background_r 0 0 1 0)
;; background color green; range [0, 1].
(param background_g 0 0 1 0)
;; background color blue; range [0, 1].
(param background_b 0 0 1 0)


(defkernel cube_flip [x y c]
  (let [p progress
        ; the visible face width follows |cos(pi*p)|
        s (max .0001 (abs (- 1 (* 2 p))))
        cx (/ width 2)
        sx (+ cx (/ (- x cx) s))
        a (sample sx y c 1 0)
        b (to-frame x y c)
        face (if (< p .5) a b)
        ; shade by the projected depth, and fill the rest with background
        inside (if (< (abs (- x cx)) (* cx s)) 1 0)
        shade (if (< p .5) (+ .3 (* .7 s)) (+ .3 (* .7 s)))
        v (* face shade)
        bg (channel c background_r background_g background_b)]
    (if (= c 3) (pixel x y 3) (if (= inside 1) v bg))))
