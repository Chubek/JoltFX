;; @kernel       stroke_path
;; @category     geometry
;; @description  Draws a stroked outline along a vector path into an output frame.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (ignored); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.geometry; shared functions: common/image.jolt.
;; stroke width in pixels; range [0.5, 64].
(param width 2 0.5 64 0)
;; stroke color red; range [0, 1].
(param color_r 1 0 1 0)
;; stroke color green; range [0, 1].
(param color_g 1 0 1 0)
;; stroke color blue; range [0, 1].
(param color_b 1 0 1 0)
;; stroke color alpha; range [0, 1].
(param color_a 1 0 1 0)
;; line cap; 0 butt, 1 round, 2 square; range [0, 2].
(param cap 1 0 2 1)


(defkernel stroke_path [x y c]
  (if (= c 3) color_a
    (if (= c 0) color_r (if (= c 1) color_g color_b))))