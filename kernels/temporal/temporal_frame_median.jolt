;; @kernel       temporal_frame_median
;; @category     temporal
;; @description  Computes median of frames over time.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.temporal; shared functions: common/image.jolt.
;; The resource array holds `window` frames, each width*height*4 floats, concatenated.
;; temporal window size; range [1, 60].
(param window 4 1 60 1)
;; channel; 0 RGB, 1 R, 2 G, 3 B, 4 A; range [0, 4].
(param channel 0 0 4 1)
;; normalize output; range [0, 1].
(param normalize 1 0 1 1)


(defkernel temporal_frame_median [x y c]
  (let [fs (* 4 (* width height))
        nf (if (= fs 0) 0 (floor (/ (data-count) fs)))]
    (if (= nf 0) (pixel x y c)
      (let [n (min window nf)
            idx (+ (* 4 (+ (* y width) x)) c)
            rank (ceil (/ (+ n 1) 2))
            med (sum k 0 n
                  (let [v (data (+ (* k fs) idx))
                        below (sum m 0 n (if (<= (data (+ (* m fs) idx)) v) 1 0))]
                    (if (= below rank) v 0)))]
        (if (= normalize 1) med med)))))
