;; @kernel brightness
;; @category color
;; @description Brightness on premultiplied RGBA.
;; @complexity Low
;; @gpu Yes
;; @since 0.2.0
;; Inputs: r g b a; output: premultiplied RGBA.
;; Parameter amount: default 1, range [0, 4], unitless.
(defkernel brightness [r g b a amount]
  (rgba
    (min a (max 0 (* r amount)))
    (min a (max 0 (* g amount)))
    (min a (max 0 (* b amount)))
    a))
