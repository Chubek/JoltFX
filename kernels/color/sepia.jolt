;; @kernel sepia
;; @category color
;; @description Sepia on premultiplied RGBA.
;; @complexity Low
;; @gpu Yes
;; @since 0.2.0
;; Inputs: r g b a; output: premultiplied RGBA.
(defkernel sepia [r g b a]
  (rgba
    (min a (max 0 (+ (+ (* r 0.393) (* g 0.769)) (* b 0.189))))
    (min a (max 0 (+ (+ (* r 0.349) (* g 0.686)) (* b 0.168))))
    (min a (max 0 (+ (+ (* r 0.272) (* g 0.534)) (* b 0.131))))
    a))
