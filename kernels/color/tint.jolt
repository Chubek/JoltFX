;; @kernel tint
;; @category color
;; @description Tint on premultiplied RGBA.
;; @complexity Low
;; @gpu Yes
;; @since 0.2.0
;; Inputs: r g b a; output: premultiplied RGBA.
;; Parameter amount: default 0.5, range [0, 1], unitless.
(defkernel tint [r g b a amount]
  (rgba
    (min a (max 0 (+ (* r (- 1 amount)) (* a (* amount 1)))))
    (min a (max 0 (+ (* g (- 1 amount)) (* a (* amount 0.5)))))
    (min a (max 0 (+ (* b (- 1 amount)) (* a (* amount 0.25)))))
    a))
