;; @kernel       nle_roll_edit
;; @category     nle
;; @description  Rolls the start of one source against another for a transition.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (outgoing frame); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.nle; shared functions: common/image.jolt.
;; The resource array holds the incoming frame, width*height*4 floats. A roll moves
;; each source vertically in opposite directions, so the cut travels across the
;; frame rather than appearing at a hard edge.
;; roll position [0,1]; range [0, 1].
(param progress 0.5 0 1 0)
;; roll angle in degrees; range [0, 360].
(param angle 0 0 360 0)
;; edge softness; range [0, 1].
(param softness 0.02 0 1 0)


(defkernel nle_roll_edit [x y c]
  (let [a (radians angle)
        sx (cos a)
        sy (sin a)
        ;; distance along the roll axis, in pixels from the frame centre
        axis (+ (* (- x (/ width 2)) sx) (* (- y (/ height 2)) sy))
        edge (* (- progress 2) 1 (max width height))
        ;; the outgoing frame slides one way, the incoming frame the other
        d (if (< softness .0001) (- axis edge)
            (- axis edge (* (* softness (max width height)) 1.5)))
        t (clamp01 (/ (+ d .000001) softness))
        out (sample x (if (< t 1) (- y (* 2 (max width height) (* t 1))) y) c 1 0)
        inc (to-frame x y c)]
    (if (< t 1) (finish out (pixel x y 3) 0) (finish inc (pixel x y 3) 0))))
