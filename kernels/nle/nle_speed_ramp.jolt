;; @kernel       nle_speed_ramp
;; @category     nle
;; @description  Creates variable speed ramp over time.
;; @complexity   Medium
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (image dst, same dimensions).
;; Module: jolt.fx.kernels.nle; shared functions: common/image.jolt.
;; The ramp needs both the frame sequence and the speed curve, and the profile
;; carries a single resource array, so both are packed into it: data[0] is the
;; curve point count N, data[1..2N] are N increasing (x,y) pairs describing the
;; rate profile, and the RGBA frames follow back to back from offset 1+2N, each
;; width*height*4 floats. An array that is not in that form -- a bare frame
;; sequence, or an empty array -- is read as frames only, and the rate profile
;; falls back to constant real-time speed, so the kernel is a safe no-op rather
;; than a crash. The playhead integrates the profile from the start of the ramp,
;; so an accelerating ramp really does move further per output frame; a fixed
;; four-step midpoint rule keeps that bounded whatever the curve length.
;; Method 0 evaluates the curve linearly, method 1 with Hermite tangents. A rate
;; above 1 spans more than one source frame per output frame, so the extra
;; covered frames are mixed in as a smear instead of being skipped.
;; output playhead in frames; range [0, 600].
(param position 20 0 600 0)
;; clip length in frames used as the ramp domain; range [1, 600].
(param duration 60 1 600 1)
;; curve evaluation method; 0 linear, 1 hermite; range [0, 1].
(param method_param 0 0 1 1)
;; interpolation; 0 nearest frame, 1 blend between frames; range [0, 1].
(param interpolation 1 0 1 1)
;; smear weight for rates above real time; range [0, 1].
(param smear 0.35 0 1 0)


;; Frames packed after the curve header, if the array carries one; otherwise the
;; whole array is the frame sequence.
(defn frame-offset [] (if (> (data-count) 0) (+ 1 (* 2 (data 0))) 0))


;; Read frame k of the packed sequence; the source pixel when the index falls
;; outside the array, and when the array is empty.
(defn ramp-frame [k px py pc]
  (let [off (frame-offset)
        fsz (* 4 width height)
        idx (+ (* fsz k) (* 4 (+ (* py width) px)) pc)]
    (if (all3 (> (data-count) 0) (>= idx off) (< idx (data-count)))
      (data idx)
      (pixel px py pc))))


;; True when the array is laid out as a length-prefixed curve plus frames. The
;; length test comes first and on its own, because the profile evaluates every
;; `and`/`allN` argument, so (data 0) must never be reached on an empty array.
(defn has-curve? []
  (if (> (data-count) 1)
    (all2 (= (data 0) (floor (data 0))) (> (data 0) 1))
    0))


;; Curve sample at t in [0,1], read at the curve offset; 1 (real time) if absent.
(defn ramp-rate [t m]
  (if (has-curve?)
    (max 0.05 (curve-value-at 1 (clamp01 t) m))
    1))


(defkernel nle_speed_ramp [x y c]
  (let [dl (max 1 duration)
        u (clamp01 (/ position dl))
        ;; running integral of the rate profile up to the playhead, four steps
        avg (/ (sum k 0 4 (ramp-rate (* u (/ (+ k 0.5) 4)) method_param)) 4)
        ;; instantaneous rate, which sets how many source frames one output covers
        inst (ramp-rate u method_param)
        raw (* position avg)
        ;; frame count of the packed sequence, minus the curve header
        avail (/ (- (data-count) (frame-offset)) (* 4 width height))
        nf (max 1 (if (has-curve?) avail (frame-count)))
        last (- nf 1)
        i0 (max 0 (min last raw))
        ;; frame reads need whole indices: snap down and carry the remainder
        ;; into the blend weight, so sub-frame speed still interpolates
        k0 (max 0 (min last (floor i0)))
        k1 (max 0 (min last (+ k0 1)))
        w (clamp01 (- i0 k0))
        ;; a fast ramp covers k0..k0+inst, so mix the far end in as a smear
        i2 (max 0 (min last (+ k0 (max 1 (round inst)))))
        sm (* smear (clamp01 (- inst 1)))
        ;; an empty array leaves the frame reads on the source pixel, so this
        ;; is a clean no-op rather than an out-of-range read
        near (if (= interpolation 0)
               (ramp-frame k0 x y c)
               (mix (ramp-frame k0 x y c) (ramp-frame k1 x y c) w))
        far (ramp-frame i2 x y c)]
    (mix near far sm)))