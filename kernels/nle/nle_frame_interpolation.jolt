;; @kernel       nle_frame_interpolation
;; @category     nle
;; @description  Interpolates frames for smooth slow motion.
;; @complexity   High
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (earlier frame); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.nle; shared functions: common/image.jolt.
;; The resource array holds the later frame, width*height*4 floats. Method 0 is a
;; plain cross-blend. Method 1 is motion compensated: a small integer search
;; (search_radius, at most three pixels) estimates the displacement from the
;; earlier to the later frame, then both frames are read at compensated offsets
;; -- the earlier at -p*d, the later at +(1-p)*d -- so at the midpoint both reads
;; land on the same moving content and the result is sharp rather than ghosted.
;; The later frame is read bilinearly, which is what makes those fractional
;; offsets pay off. Method 2 estimates from both directions and averages, which
;; stabilises occluded areas; optical_flow half-weights that. The search covers
;; the whole (2r+1)^2 window jointly, because a match along one axis can mimic the
;; other on smooth content. With no fold primitive the minimiser is taken as an
;; exponentially weighted mean of the candidates; a two-tap SAD lies in [0,2], so
;; the weights concentrate hard on the winner and the mean is effectively that
;; integer argmin. Where nothing dominates -- a flat or occluded region, or an
;; empty resource -- the no-shift candidate carries the weight and the estimate
;; collapses to zero, so the kernel degrades to a plain blend rather than
;; drifting or failing.
;; blend position [0,1] between the two frames; range [0, 1].
(param position 0.5 0 1 0)
;; interpolation method; 0 cross-blend, 1 motion compensated, 2 bidirectional; range [0, 2].
(param method_param 1 0 2 1)
;; bidirectional refinement weight; 0 forward estimate only; range [0, 1].
(param optical_flow 0 0 1 1)
;; integer motion search radius in pixels; range [1, 3].
(param search_radius 2 1 3 1)


;; Clamped integer read of the later frame. The search runs over whole-pixel
;; offsets, so this cheap read is all it needs.
(defn next-s [px py pc]
  (to-frame (max 0 (min (- width 1) px))
            (max 0 (min (- height 1) py)) pc))


;; Bilinear read of the later frame, for the compensated read itself, where the
;; fractional offset is the whole point.
(defn next-bilin [px py pc]
  (let [xf (floor px) yf (floor py)
        fx (- px xf) fy (- py yf)
        x0 (max 0 (min (- width 1) xf)) x1 (max 0 (min (- width 1) (+ xf 1)))
        y0 (max 0 (min (- height 1) yf)) y1 (max 0 (min (- height 1) (+ yf 1)))
        gx (- 1 fx) gy (- 1 fy)]
    (+ (* (next-s x0 y0 pc) (* gx gy))
       (* (next-s x1 y0 pc) (* fx gy))
       (* (next-s x0 y1 pc) (* gx fy))
       (* (next-s x1 y1 pc) (* fx fy)))))


;; SAD of the earlier frame at (px,py) against the later frame at (px+dx,py+dy).
;; A single luma channel over two taps is enough to locate the match, and it
;; keeps the search to four texel reads per candidate, which matters because the
;; whole (2r+1)^2 window is visited for every output pixel.
(defn sad-fwd [px py dx dy]
  (+ (abs (- (pixel px py 1) (next-s (+ px dx) (+ py dy) 1)))
     (abs (- (pixel (+ px 1) py 1) (next-s (+ px dx 1) (+ py dy) 1)))))


;; The same cost the other way round: the later frame at (px,py) against the
;; earlier frame at (px+dx,py+dy). Its minimiser is the negated displacement.
(defn sad-rev [px py dx dy]
  (+ (abs (- (next-s px py 1) (pixel (+ px dx) (+ py dy) 1)))
     (abs (- (next-s (+ px 1) py 1) (pixel (+ px dx 1) (+ py dy) 1)))))


;; Candidate count in the search window, and the dx/dy of one candidate code.
(defn win-n [] (let [r (max 1 (min 3 search_radius))] (* (+ 1 (* 2 r)) (+ 1 (* 2 r)))))
(defn code-dx [code]
  (let [r (max 1 (min 3 search_radius))] (- (mod code (* 2 (+ 1 r))) r)))
(defn code-dy [code]
  (let [r (max 1 (min 3 search_radius))] (- (floor (/ code (* 2 (+ 1 r)))) r)))


;; Soft-argmin weight of one candidate in the requested direction.
(defn sad-code [px py code rev]
  (let [r (max 1 (min 3 search_radius))
        dx (- (mod code (* 2 (+ 1 r))) r)
        dy (- (floor (/ code (* 2 (+ 1 r)))) r)]
    (exp (* -12 (if (= rev 0) (sad-fwd px py dx dy) (sad-rev px py dx dy))))))


;; Weighted mean of the candidate offsets, i.e. the soft argmin of the window.
(defn flow-dx [px py rev wt]
  (/ (sum i 0 (win-n) (* (sad-code px py i rev) (code-dx i))) wt))


(defn flow-dy [px py rev wt]
  (/ (sum i 0 (win-n) (* (sad-code px py i rev) (code-dy i))) wt))


(defkernel nle_frame_interpolation [x y c]
  (let [;; the search only runs for the compensating methods
        search (if (= method_param 0) 0 1)
        ;; the window weight total is reused by all three estimates
        wt (max 1e-9 (sum i 0 (win-n) (sad-code x y i 0)))
        ;; share of that weight held by no-shift: above one half the window found
        ;; nothing better than staying put, so the estimate fades to zero rather
        ;; than drifting on flat or ambiguous content
        zero (* (max 1 (min 3 search_radius))
               (+ 2 (* 1 (max 1 (min 3 search_radius)))))
        hold (/ (sad-code x y zero 0) wt)
        conf (if (= search 0) 0 (max 0 (min 1 (* 8 (- 1 hold)))))
        fdx (/ (* conf (sum i 0 (win-n) (* (sad-code x y i 0) (code-dx i)))) wt)
        fdy (/ (* conf (sum i 0 (win-n) (* (sad-code x y i 0) (code-dy i)))) wt)
        ;; the reverse pass costs as much again, so it runs only when asked for,
        ;; and it is negated to match the forward sign
        refine (if (= method_param 2) 1 (if (= optical_flow 1) 0.5 0))
        rwt (if (= refine 0) 1
               (max 1e-9 (sum i 0 (win-n) (sad-code x y i 1))))
        rdx (if (= refine 0) 0 (* refine (flow-dx x y 1 rwt)))
        rdy (if (= refine 0) 0 (* refine (flow-dy x y 1 rwt)))
        dx (- fdx rdx)
        dy (- fdy rdy)
        p (clamp01 position)
        ;; read the earlier frame at -p*d and the later one at +(1-p)*d, so both
        ;; land on the moving content and the midpoint stays sharp
        a (if (= search 0) (pixel x y c)
             (sample (- x (* p dx)) (- y (* p dy)) c 1 1))
        b (if (= search 0) (next-bilin x y c)
             (next-bilin (+ x (* (- 1 p) dx)) (+ y (* (- 1 p) dy)) c))]
    (if (= c 3) (mix a b p) (finish (mix a b p) (pixel x y 3) 0))))