;; @kernel       nle_frame_interpolation
;; @category     nle
;; @description  Interpolates frames for smooth slow motion.
;; @complexity   High
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (earlier frame); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.nle; shared functions: common/image.jolt.
;; The resource array holds the later frame, width*height*4 floats. Method 0 is a
;; plain cross-blend. Method 1 is motion compensated: a small integer search
;; (search_radius, at most three pixels) estimates the displacement from the
;; earlier to the later frame, and both frames are then sampled at compensated
;; offsets -- the earlier at -p*d, the later at +(1-p)*d -- so at the midpoint
;; both reads land on the same moving content and the result is sharp rather
;; than ghosted. Method 2 searches from both directions and averages the two
;; estimates, which stabilises occluded areas; optical_flow applies half of that
;; refinement. The search is a coordinate descent on the SAD, two passes of
;; 2r+1 candidates rather than a full (2r+1)^2 sweep, which keeps the per-pixel
;; cost bounded. An empty resource makes every cost zero, so the estimate is zero
;; and the result degrades to a plain blend instead of failing.
;; blend position [0,1] between the two frames; range [0, 1].
(param position 0.5 0 1 0)
;; interpolation method; 0 cross-blend, 1 motion compensated, 2 bidirectional; range [0, 2].
(param method_param 1 0 2 1)
;; bidirectional refinement weight; 0 forward estimate only; range [0, 1].
(param optical_flow 0 0 1 1)
;; integer motion search radius in pixels; range [1, 3].
(param search_radius 2 1 3 1)


;; Clamped, rounded read of the later frame, so a search can step off the edge.
(defn next-s [px py pc]
  (to-frame (max 0 (min (- width 1) (round px)))
            (max 0 (min (- height 1) (round py))) pc))


;; Luma of the later frame, unpremultiplied.
(defn next-luma [px py]
  (let [al (next-s px py 3)]
    (if (> al 0) (/ (+ (* 0.2126 (next-s px py 0)) (* 0.7152 (next-s px py 1))
                       (* 0.0722 (next-s px py 2))) al) 0)))


;; SAD of the earlier frame at (px,py) against the later frame at (px+dx,py+dy),
;; over two taps so a single noisy pixel cannot decide the offset.
(defn sad-fwd [px py dx dy]
  (+ (abs (- (luminance px py) (next-luma (+ px dx) (+ py dy))))
     (abs (- (luminance (+ px 1) py) (next-luma (+ px dx 1) (+ py dy))))))


;; The same cost measured the other way round: the later frame at (px,py) against
;; the earlier frame at (px+dx,py+dy). Its argmin is the negated displacement.
(defn sad-rev [px py dx dy]
  (+ (abs (- (next-luma px py) (luminance (+ px dx) (+ py dy))))
     (abs (- (next-luma (+ px 1) py) (luminance (+ px dx 1) (+ py dy))))))


;; Integer argmin over dx in [lo,hi] at dy = 0, by a bounded recursive descent.
(defn best-dx [px py lo hi rev bd bc]
  (if (> lo hi) bd
    (let [c (if (= rev 0) (sad-fwd px py lo 0) (sad-rev px py lo 0))]
      (if (< c bc)
        (best-dx px py (+ lo 1) hi rev lo c)
        (best-dx px py (+ lo 1) hi rev bd bc)))))


;; Integer argmin over dy in [lo,hi] with dx already fixed.
(defn best-dy [px py lo hi rev bd bc]
  (if (> lo hi) bd
    (let [c (if (= rev 0) (sad-fwd px py bd lo) (sad-rev px py bd lo))]
      (if (< c bc)
        (best-dy px py (+ lo 1) hi rev bd c)
        (best-dy px py (+ lo 1) hi rev bd bc)))))


;; Forward displacement estimate. The two axes are searched independently from
;; zero, a coordinate-descent step each, so the whole estimate costs 2*(2r+1)
;; SAD evaluations rather than the (2r+1)^2 of a full sweep.
(defn flow-x-fwd [px py r] (best-dx px py (- r) r 0 0 (* 2 (+ 1 r))))
(defn flow-y-fwd [px py r] (best-dy px py (- r) r 0 0 (* 2 (+ 1 r))))
;; The reverse searches find the same displacement measured the other way, so
;; they are negated to match the forward sign.
(defn flow-x-rev [px py r] (- (best-dx px py (- r) r 1 0 (* 2 (+ 1 r)))))
(defn flow-y-rev [px py r] (- (best-dy px py (- r) r 1 0 (* 2 (+ 1 r)))))


(defkernel nle_frame_interpolation [x y c]
  (let [r (max 1 (min 3 search_radius))
        ;; the search only runs for the compensating methods
        search (if (= method_param 0) 0 1)
        fx (if (= search 0) 0 (flow-x-fwd x y r))
        fy (if (= search 0) 0 (flow-y-fwd x y r))
        bx (if (= search 0) 0 (flow-x-rev x y r))
        by (if (= search 0) 0 (flow-y-rev x y r))
        ;; method 2 averages both estimates outright; optical_flow half-weights it
        refine (if (= method_param 2) 1 (if (= optical_flow 1) 0.5 0))
        w (if (= search 0) 0 (* (- 1 (* refine 0.5)) 0.5))
        dx (* w (+ fx bx))
        dy (* w (+ fy by))
        p (clamp01 position)
        ;; read the earlier frame at -p*d and the later one at +(1-p)*d, so both
        ;; land on the moving content and the midpoint stays sharp
        a (if (= search 0) (pixel x y c)
             (sample (- x (* p dx)) (- y (* p dy)) c 1 1))
        b (if (= search 0) (next-s x y c)
             (next-s (+ x (* (- 1 p) dx)) (+ y (* (- 1 p) dy)) c))]
    (if (= c 3) (mix a b p) (finish (mix a b p) (pixel x y 3) 0))))