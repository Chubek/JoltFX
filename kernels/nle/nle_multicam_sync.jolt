;; @kernel       nle_multicam_sync
;; @category     nle
;; @description  Synchronizes multiple camera angles by timecode.
;; @complexity   High
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (image dst, same dimensions).
;; Module: jolt.fx.kernels.nle; shared functions: common/image.jolt.
;; The resource array holds the multicam take: `angles` groups of frames, one
;; group per camera, each group the same length, so frame a*f + k is angle a at
;; local frame k. Each angle is aligned to angle 0, the reference, by a small
;; integer-search correlation: over a search radius of a couple of pixels the
;; offset with the smallest luma difference is chosen by an exponentially
;; weighted mean, and the live angle is then sampled at that offset so it lines
;; up with the reference. The switcher cuts between angles on the interval: each
;; interval of timecode holds one angle, crossfading across the boundary.
;; sync_method 0 uses plain luma SAD; 1 adds the frame difference so matching
;; detail dominates the estimate and exposure differences matter less. A missing
;; angle falls back to the source frame rather than reading out of range.
;; timecode position within the take, in frames; range [0, 100000].
(param timecode 0 0 100000 0)
;; number of camera angles packed into the resource; range [1, 8].
(param angles 3 1 8 1)
;; frames per angle; range [1, 600].
(param frames_per_angle 40 1 600 1)
;; cut interval on the switcher, in timecode frames; range [1, 600].
(param interval 10 1 600 1)
;; correlation method; 0 luma SAD, 1 frame difference; range [0, 1].
(param sync_method 0 0 1 1)
;; integer alignment search radius, in pixels; range [1, 3].
(param search_radius 2 1 3 1)


;; Clamped read of one frame of the resource array.
(defn cam-at [k px py pc]
  (frame-at k (max 0 (min (- width 1) px)) (max 0 (min (- height 1) py)) pc))


;; Luma of the resource frame k, unpremultiplied.
(defn cam-luma [k px py]
  (let [a (cam-at k px py 3)]
    (if (> a 0) (/ (+ (* 0.2126 (cam-at k px py 0)) (* 0.7152 (cam-at k px py 1))
                       (* 0.0722 (cam-at k px py 2))) a) 0)))


;; One SAD tap at (px,py) between the reference angle and the candidate angle
;; displaced by (dx,dy). Method 1 adds the frame difference so the search keys on
;; matching structure rather than absolute exposure.
(defn cam-sad [ref cand px py dx dy sm]
  (let [r0 (cam-luma ref px py)
        r1 (cam-luma ref (+ px 1) py)
        r2 (cam-luma ref px (+ py 1))
        c0 (cam-luma cand (+ px dx) (+ py dy))
        c1 (cam-luma cand (+ px dx 1) (+ py dy))
        c2 (cam-luma cand (+ px dx) (+ py dy 1))]
    (if (= sm 1)
      (+ (abs (- r0 r1)) (abs (- r0 r2))
         (abs (- (- r0 r1) (- c0 c1))) (abs (- (- r0 r2) (- c0 c2))))
      (+ (abs (- r0 c0)) (abs (- r1 c1)) (abs (- r2 c2))))))


;; Soft-argmin weight for a candidate offset: exp(-k * sad) peaks on the match.
(defn cam-w [ref cand px py dx dy sm]
  (exp (* -6 (cam-sad ref cand px py dx dy sm))))


(defkernel nle_multicam_sync [x y c]
  (let [n (frame-count)
        na (max 1 (min 8 angles))
        fpa (max 1 frames_per_angle)
        r (max 1 (min 3 search_radius))
        iv (max 1 interval)
        ;; switcher state: which angle is live and how far into the cut we are
        cut (floor (/ (max 0 timecode) iv))
        ai (mod cut na)
        prev (mod (+ (- cut 1) na) na)
        blend (clamp01 (/ (mod (max 0 timecode) iv) iv))
        ;; local frame inside each angle
        lf (mod (max 0 timecode) fpa)
        refk (min (- n 1) lf)
        ck (min (- n 1) (+ (* ai fpa) lf))
        pk (min (- n 1) (+ (* prev fpa) lf))
        ;; integer-search alignment of the live angle against the reference
        w (max 0.000001 (sum j (- r) (+ r 1)
                          (sum i (- r) (+ r 1) (cam-w refk ck x y i j sync_method))))
        wsumx (sum j (- r) (+ r 1)
                 (sum i (- r) (+ r 1) (* (cam-w refk ck x y i j sync_method) i)))
        wsumy (sum j (- r) (+ r 1)
                 (sum i (- r) (+ r 1) (* (cam-w refk ck x y i j sync_method) j)))
        dx (/ wsumx w)
        dy (/ wsumy w)
        sx (max 0 (min (- width 1) (round (+ x dx))))
        sy (max 0 (min (- height 1) (round (+ y dy))))
        live (cam-at ck sx sy c)
        prevf (cam-at pk x y c)]
    (if (< n 1) (pixel x y c)
      ;; crossfade from the outgoing angle into the incoming one across the cut
      (mix prevf live blend))))