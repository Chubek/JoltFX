;; @kernel       edge_detect
;; @category     data_analysis
;; @description  Detects image edges and outputs an edge-strength frame.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.data_analysis; shared functions: common/image.jolt.
;; low threshold; range [0, 1].
(param low_threshold 0.1 0 1 0)
;; high threshold; range [0, 1].
(param high_threshold 0.2 0 1 0)
;; operator; 0 sobel, 1 scharr, 2 prewitt; range [0, 2].
(param operator 0 0 2 1)
;; blur radius; range [0, 4].
(param blur_radius 0 0 4 0)
;; output mode; 0 magnitude, 1 magnitude+direction; range [0, 1].
(param output_mode 0 0 1 1)


(defkernel edge_detect [x y c]
  (if (= c 3) 1
    (pixel x y c)))