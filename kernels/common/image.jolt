;; Shared Joltscript functions for the bounded CPU image execution profile.
;; Coordinates of texel centers are integer pixels; transforms use normalized
;; edge coordinates (x + 0.5)/width. All accumulation uses runtime f64 locals.
(defn clamp01 [v] (min 1 (max 0 v)))
(defn mix [a b t] (+ a (* t (- b a))))
(defn radians [v] (* v (/ pi 180)))
(defn smooth [a b x]
  (let [t (clamp01 (/ (- x a) (- b a)))] (* t t (- 3 (* 2 t)))))
(defn pixel [x y c] (sample x y c 0 1))
(defn straight [x y c]
  (let [a (pixel x y 3)] (if (> a 0) (/ (pixel x y c) a) 0)))
(defn luma [r g b] (+ (* .2126 r) (* .7152 g) (* .0722 b)))
(defn luminance [x y] (luma (straight x y 0) (straight x y 1) (straight x y 2)))
(defn channel [c r g b] (if (= c 0) r (if (= c 1) g b)))
(defn finish [value alpha clip] (* alpha (if clip (clamp01 value) value)))
(defn decode [v] (if (<= v .04045) (/ v 12.92) (pow (/ (+ v .055) 1.055) 2.4)))
(defn encode [v] (if (<= v .0031308) (* v 12.92) (- (* 1.055 (pow v (/ 1 2.4))) .055)))
;; Domain-aware color tables imported by Glue, including baked OCIO transforms.
;; Header: dimension (1/3), edge, RGB domain minima/maxima; then RGB triples.
(defn table-at [r g b c n] (data (+ 8 (* 3 (+ r (* n (+ g (* n b))))) c)))
(defn table-slice [r g b c n]
  (let [i (floor r) j (floor g) ii (min (+ i 1) (- n 1)) jj (min (+ j 1) (- n 1))]
    (mix (mix (table-at i j b c n) (table-at ii j b c n) (- r i))
         (mix (table-at i jj b c n) (table-at ii jj b c n) (- r i)) (- g j))))
(defn table-domain [v c n]
  (* (clamp01 (/ (- v (data (+ 2 c))) (- (data (+ 5 c)) (data (+ 2 c))))) (- n 1)))
(defn color-table [x y c amount interpolation]
  (if (or (= c 3) (or (= amount 0) (= (data-count) 0))) (pixel x y c)
    (let [n (data 1) dim (data 0)
          valid (require (and (>= n 2) (= (data-count) (+ 8 (* 3 (if (= dim 1) n (* n n n)))))))
          r (table-domain (straight x y 0) 0 n)
          g (table-domain (straight x y 1) 1 n)
          b (table-domain (straight x y 2) 2 n)
          t (channel c r g b) i (floor t)
          mapped (if (= dim 1)
                   (if (= interpolation 0) (table-at (round t) 0 0 c n)
                     (mix (table-at i 0 0 c n) (table-at (min (+ i 1) (- n 1)) 0 0 c n) (- t i)))
                   (if (= interpolation 0) (table-at (round r) (round g) (round b) c n)
                     (mix (table-slice r g (floor b) c n)
                          (table-slice r g (min (+ (floor b) 1) (- n 1)) c n) (- b (floor b)))))]
      (finish (mix (straight x y c) mapped amount) (pixel x y 3) 0))))
(defn wrap [x n] (mod (+ (mod x n) n) n))
;; Inverse homography via adjugate. Parameters describe source -> destination.
(defn warp-one [x y c a b d e f g h i j interpolation border]
  (let [aa (- (* f j) (* g i)) bb (- (* d i) (* b j)) dd (- (* b g) (* d f))
        ee (- (* g h) (* e j)) ff (- (* a j) (* d h)) gg (- (* d e) (* a g))
        hh (- (* e i) (* f h)) ii (- (* b h) (* a i)) jj (- (* a f) (* b e))
        determinant (+ (* a aa) (* b ee) (* d hh))
        valid (require (> (abs determinant) .000000000001))
        u (/ (+ x .5) width) v (/ (+ y .5) height)
        w (+ (* hh u) (* ii v) jj)]
    (if (< (abs w) .000000000001) 0
      (sample (- (* width (/ (+ (* aa u) (* bb v) dd) w)) .5)
              (- (* height (/ (+ (* ee u) (* ff v) gg) w)) .5)
              c interpolation border))))
(defn warp [x y c a b d e f g h i j interpolation border antialias]
  (if antialias
    (/ (+ (warp-one (- x .25) (- y .25) c a b d e f g h i j interpolation border)
          (warp-one (+ x .25) (- y .25) c a b d e f g h i j interpolation border)
          (warp-one (- x .25) (+ y .25) c a b d e f g h i j interpolation border)
          (warp-one (+ x .25) (+ y .25) c a b d e f g h i j interpolation border)) 4)
    (warp-one x y c a b d e f g h i j interpolation border)))
;; Hue in [0,6); chroma-sector reconstruction works for both HSV and HSL.
(defn hue [r g b]
  (let [hi (max r (max g b)) lo (min r (min g b)) d (- hi lo)]
    (if (<= d .000000000001) 0
      (wrap (if (= hi r) (/ (- g b) d)
              (if (= hi g) (+ 2 (/ (- b r) d)) (+ 4 (/ (- r g) d)))) 6))))
(defn hue-component [h c]
  (let [k (wrap (+ h (if (= c 0) 0 (if (= c 1) 4 2))) 6)]
    (clamp01 (- (abs (- k 3)) 1))))
(defn rotated [x y c angle]
  (let [r (straight x y 0) g (straight x y 1) b (straight x y 2)
        lo (min r (min g b)) hi (max r (max g b))
        h (wrap (+ (hue r g b) (/ angle 60)) 6)]
    (+ lo (* (- hi lo) (hue-component h c)))))
(defn balance-value [x y c sr sg sb mr mg mb hr hg hb]
  (let [l (luminance x y) shadow (- 1 (smooth 0 .5 l)) highlight (smooth .5 1 l)
        mid (- 1 shadow highlight)]
    (+ (straight x y c) (* shadow (channel c sr sg sb))
       (* mid (channel c mr mg mb)) (* highlight (channel c hr hg hb)))))
;; Curve data: increasing (x,y) pairs. Hermite tangents are finite differences.
(defn curve-x [i] (data (* 2 i)))
(defn curve-y [i] (data (+ 1 (* 2 i))))
(defn curve-slope [i n]
  (let [a (max 0 (- i 1)) b (min (- n 1) (+ i 1))]
    (/ (- (curve-y b) (curve-y a)) (- (curve-x b) (curve-x a)))))
(defn curve-segment [v i n method]
  (let [x0 (curve-x i) x1 (curve-x (+ i 1))
        valid (require (> x1 x0))
        t (/ (- v x0) (- x1 x0)) y0 (curve-y i) y1 (curve-y (+ i 1))]
    (if (and (>= v x0) (< v x1))
      (if (= method 0) (mix y0 y1 t)
        (+ (* (+ (* 2 t t t) (- (* 3 t t)) 1) y0)
           (* (+ (* t t t) (- (* 2 t t)) t) (- x1 x0) (curve-slope i n))
           (* (+ (- (* 2 t t t)) (* 3 t t)) y1)
           (* (- (* t t t) (* t t)) (- x1 x0) (curve-slope (+ i 1) n)))) 0)))
(defn curve-value [v method]
  (if (= (data-count) 0) v
    (let [n (/ (data-count) 2) valid (require (and (>= n 2) (= n (floor n))))
          ordered (sum i 0 (- n 1) (require (> (curve-x (+ i 1)) (curve-x i))))]
      (if (<= v (curve-x 0)) (curve-y 0)
        (if (>= v (curve-x (- n 1))) (curve-y (- n 1))
          (sum i 0 (- n 1) (curve-segment v i n method)))))))
;; Length-prefixed curves packed back to back: data[off] = point count N, then N
;; (x,y) pairs. Lets one resource carry several independent curves (for example
;; per-channel grading); each curve is located by its own offset.
(defn curve-n-at [off] (if (<= (data-count) off) 0 (data off)))
;; data[off] is the point count, so point i's x is at off+1+2i and its y at off+2+2i
(defn curve-x-at [off i] (data (+ (+ off 1) (* 2 i))))
(defn curve-y-at [off i] (data (+ (+ off 2) (* 2 i))))
(defn curve-slope-at [off i n]
  (let [a (max 0 (- i 1)) b (min (- n 1) (+ i 1))]
    (/ (- (curve-y-at off b) (curve-y-at off a)) (- (curve-x-at off b) (curve-x-at off a)))))
(defn curve-value-at [off v method]
  (let [n (curve-n-at off)]
    (if (< n 2) v
      (let [valid (require (= n (floor n)))
            ordered (sum i 0 (- n 1) (require (> (curve-x-at off (+ i 1)) (curve-x-at off i))))]
        (if (<= v (curve-x-at off 0)) (curve-y-at off 0)
          (if (>= v (curve-x-at off (- n 1))) (curve-y-at off (- n 1))
            (sum i 0 (- n 1)
              (let [x0 (curve-x-at off i) x1 (curve-x-at off (+ i 1))
                    t (/ (- v x0) (- x1 x0))
                    y0 (curve-y-at off i) y1 (curve-y-at off (+ i 1))]
                (if (all2 (>= v x0) (< v x1))
                  (if (= method 0) (mix y0 y1 t)
                    (+ (* (+ (* 2 t t t) (- (* 3 t t)) 1) y0)
                       (* (+ (* t t t) (- (* 2 t t)) t) (- x1 x0) (curve-slope-at off i n))
                       (* (+ (- (* 2 t t t)) (* 3 t t)) y1)
                       (* (- (* t t t) (* t t)) (- x1 x0) (curve-slope-at off (+ i 1) n))))
                  0)))))))))
;; LUT data is RGB triples, red index fastest, then green, then blue.
(defn lut-at [r g b c n] (data (+ (* 3 (+ r (* n (+ g (* n b))))) c)))
(defn lut-slice [r g b c n]
  (let [ri (floor r) gi (floor g) rj (min (+ ri 1) (- n 1)) gj (min (+ gi 1) (- n 1))]
    (mix (mix (lut-at ri gi b c n) (lut-at rj gi b c n) (- r ri))
         (mix (lut-at ri gj b c n) (lut-at rj gj b c n) (- r ri)) (- g gi))))
(defn lut-value [r g b c method]
  (if (= (data-count) 0) (channel c r g b)
    (let [n (round (pow (/ (data-count) 3) (/ 1 3)))
          valid (require (and (>= n 2) (= (* 3 n n n) (data-count))))
          rr (* (clamp01 r) (- n 1)) gg (* (clamp01 g) (- n 1)) bb (* (clamp01 b) (- n 1))]
      (if (= method 0) (lut-at (round rr) (round gg) (round bb) c n)
        (mix (lut-slice rr gg (floor bb) c n)
             (lut-slice rr gg (min (+ 1 (floor bb)) (- n 1)) c n) (- bb (floor bb)))))))
(defn gaussian-weight [i sigma] (exp (- (/ (* i i) (* 2 sigma sigma)))))
(defn gaussian-row [x y c radius sigma border]
  (/ (sum i (- radius) (+ radius 1) (* (gaussian-weight i sigma) (sample (+ x i) y c 0 border)))
     (sum i (- radius) (+ radius 1) (gaussian-weight i sigma))))

;; Hash function for procedural noise. Returns pseudo-random value in [0,1).
(defn hash2 [x y seed]
  (let [h (+ (* x 374761393.0) (* y 668265263.0) (* seed 1013904223.0))
        h (mod (+ h 4294967296.0) 4294967296.0)]
    (/ h 4294967296.0)))

;; Value noise (Perlin-style) with smooth interpolation.
(defn value-noise [x y seed]
  (let [xi (floor x) yi (floor y)
        xf (- x xi) yf (- y yi)
        u (* xf xf (- 3 (* 2 xf)))
        v (* yf yf (- 3 (* 2 yf)))
        aa (hash2 xi yi seed)
        ab (hash2 xi (+ yi 1) seed)
        ba (hash2 (+ xi 1) yi seed)
        bb (hash2 (+ xi 1) (+ yi 1) seed)]
    (mix (mix aa ba u) (mix ab bb u) v)))

;; Fractal Brownian motion - multiple octaves of value noise.
(defn fractal-noise [x y seed octaves persistence lacunarity]
  (let [total (sum i 0 octaves
              (let [scale (pow lacunarity i)
                    amp (pow persistence i)]
                (* amp (value-noise (* x scale) (* y scale) (+ seed i)))))
        norm (sum i 0 octaves (pow persistence i))]
    (/ total norm)))

;; Worley (cellular) noise distance to nearest feature point.
(defn worley-cell [x y cx cy seed]
  (let [px (+ cx (hash2 cx cy seed))
        py (+ cy (hash2 cx cy (+ seed 1)))]
    (sqrt (+ (* (- x px) (- x px)) (* (- y py) (- y py))))))

(defn worley-dist [x y seed]
  (let [xi (floor x) yi (floor y)
        d00 (worley-cell x y xi yi seed)
        d10 (worley-cell x y (+ xi 1) yi seed)
        d01 (worley-cell x y xi (+ yi 1) seed)
        d11 (worley-cell x y (+ xi 1) (+ yi 1) seed)
        dm10 (worley-cell x y (- xi 1) yi seed)
        d0m1 (worley-cell x y xi (- yi 1) seed)
        dm1m1 (worley-cell x y (- xi 1) (- yi 1) seed)
        d1m1 (worley-cell x y (+ xi 1) (- yi 1) seed)
        dm11 (worley-cell x y (- xi 1) (+ yi 1) seed)]
    (min d00 (min d10 (min d01 (min d11 (min dm10 (min d0m1 (min dm1m1 (min d1m1 dm11))))))))))

;; Simplex noise (2D) - simplified value noise on skewed grid.
(defn simplex2 [x y seed]
  (let [f2 0.5773502691896258
        s (* (+ x y) f2)
        i (floor (+ x s))
        j (floor (+ y s))
        t (* (+ i j) f2)
        x0 (- (- x i) t)
        y0 (- (- y j) t)
        i1 (if (> x0 y0) 1 0)
        j1 (if (> x0 y0) 0 1)
        x1 (- (- x0 i1) f2)
        y1 (- (- y0 j1) f2)
        x2 (- (- x0 1) (* 2 f2))
        y2 (- (- y0 1) (* 2 f2))
        n0 (simplex-corner x0 y0 i j seed)
        n1 (simplex-corner x1 y1 (+ i i1) (+ j j1) seed)
        n2 (simplex-corner x2 y2 (+ i 1) (+ j 1) seed)]
    (* 70.0 (+ n0 n1 n2))))

(defn simplex-corner [x y i j seed]
  (let [t (- 0.5 (+ (* x x) (* y y)))
        t (max t 0)]
    (* t t t t (hash2 i j seed))))

;; ---------------------------------------------------------------------------
;; Blend-mode helpers. Operate on straight (unpremultiplied) channel values.
(defn blend-normal [a b] b)
(defn blend-multiply [a b] (* a b))
(defn blend-screen [a b] (- 1 (* (- 1 a) (- 1 b))))
(defn blend-darken [a b] (min a b))
(defn blend-lighten [a b] (max a b))
(defn blend-difference [a b] (abs (- a b)))
(defn blend-exclusion [a b] (+ a b (- (* 2 a b))))
(defn blend-add [a b] (min 1 (+ a b)))
(defn blend-subtract [a b] (max 0 (- a b)))
(defn blend-overlay [a b] (if (< a .5) (* 2 a b) (- 1 (* 2 (- 1 a) (- 1 b)))))
(defn blend-hard-light [a b] (blend-overlay b a))
(defn blend-soft-light [a b]
  (if (< b .5)
    (- a (* (- 1 a) b (- 1 a)))
    (+ a (* (- 1 a) (- b .5) a))))
(defn blend-color-dodge [a b] (if (<= b 0) 0 (min 1 (/ a (- 1 b)))))
(defn blend-color-burn [a b] (if (>= b 1) 1 (- 1 (min 1 (/ (- 1 a) b)))))
;; Select by integer mode id: 0 normal,1 multiply,2 screen,3 overlay,4 darken,
;; 5 lighten,6 difference,7 exclusion,8 add,9 subtract,10 hard,11 soft,12 dodge,13 burn
(defn blend-mode [mode a b]
  (if (= mode 0) (blend-normal a b)
    (if (= mode 1) (blend-multiply a b)
      (if (= mode 2) (blend-screen a b)
        (if (= mode 3) (blend-overlay a b)
          (if (= mode 4) (blend-darken a b)
            (if (= mode 5) (blend-lighten a b)
              (if (= mode 6) (blend-difference a b)
                (if (= mode 7) (blend-exclusion a b)
                  (if (= mode 8) (blend-add a b)
                    (if (= mode 9) (blend-subtract a b)
                      (if (= mode 10) (blend-hard-light a b)
                        (if (= mode 11) (blend-soft-light a b)
                          (if (= mode 12) (blend-color-dodge a b)
                            (blend-color-burn a b)))))))))))))))

;; ---------------------------------------------------------------------------
;; Color helpers.
(defn max3 [a b c] (max a (max b c)))
(defn min3 [a b c] (min a (min b c)))
;; Boolean helpers: `or`/`and` are strictly binary in the image profile.
(defn any2 [a b] (or a b))
(defn any3 [a b c] (or a (or b c)))
(defn any4 [a b c d] (or (or a b) (or c d)))
(defn all2 [a b] (and a b))
(defn all3 [a b c] (and a (and b c)))
(defn all4 [a b c d] (and (and a b) (and c d)))
;; Saturation in [0,1] (HSV definition).
(defn saturation [r g b]
  (let [hi (max3 r g b)]
    (if (> hi 0) (/ (- hi (min3 r g b)) hi) 0)))
;; Scale chroma around luminance, preserving luma.
(defn saturate [r g b amount]
  (let [l (luma r g b)]
    (mix l r amount)))
(defn contrast-around [v amount pivot] (+ pivot (* amount (- v pivot))))
;; Soft tonal weights used by shadow/highlight style controls.
(defn shadow-weight [l] (- 1 (smooth 0 .5 l)))
(defn highlight-weight [l] (smooth .5 1 l))
;; sRGB <-> Rec.709 / Rec.2020 / Display P3 matrices are folded into helpers.
(defn mat3 [m00 m01 m02 m10 m11 m12 m20 m21 m22 r g b c]
  (if (= c 0) (+ (* m00 r) (* m01 g) (* m02 b))
    (if (= c 1) (+ (* m10 r) (* m11 g) (* m12 b))
      (+ (* m20 r) (* m21 g) (* m22 b)))))
;; Rec.709 -> Rec.2020 (linear light).
(defn rec709-to-rec2020 [r g b c]
  (mat3 0.6274 0.3293 0.0433 0.0691 0.9195 0.0114 0.0164 0.0880 0.8956 r g b c))
;; sRGB (linear) -> Display P3 (linear).
(defn srgb-to-p3 [r g b c]
  (mat3 0.8225 0.1774 0.0 0.0332 0.9669 0.0 0.0171 0.0724 0.9105 r g b c))
;; Rec.2020 -> Rec.709 (linear light), inverse of the above.
(defn rec2020-to-rec709 [r g b c]
  (mat3 1.6605 -0.5876 -0.0728 -0.1246 1.1329 -0.0083 -0.0182 -0.1006 1.1187 r g b c))
;; Display P3 (linear) -> sRGB (linear).
(defn p3-to-srgb [r g b c]
  (mat3 1.2249 -0.2247 0.0 -0.0420 1.0419 0.0 -0.0197 -0.0786 1.0983 r g b c))

;; Decode one channel of `space` to linear light (sRGB/Rec.709 hub primaries).
;; 0 sRGB, 1 linear, 2 Rec.709, 3 Rec.2020, 4 Display P3.
(defn to-linear-channel [space r g b c]
  (let [dr (decode r) dg (decode g) db (decode b)]
    (if (= space 1) (channel c r g b)
      (if (= space 3) (rec2020-to-rec709 dr dg db c)
        (if (= space 4) (p3-to-srgb dr dg db c)
          (channel c dr dg db))))))
;; Encode one channel of linear light to `space`.
(defn from-linear-channel [space lr lg lb c]
  (if (= space 1) (channel c lr lg lb)
    (if (= space 3) (encode (rec709-to-rec2020 lr lg lb c))
      (if (= space 4) (encode (srgb-to-p3 lr lg lb c))
        (encode (channel c lr lg lb))))))

;; ---------------------------------------------------------------------------
;; Flattened path helpers. A path at array offset `off` is:
;;   data[off] = vertex count N, then N (x,y) pairs in normalized [0,1] space.
;; A path with off = 0 is the common case used by single-path kernels.
(defn path-n-at [off] (if (<= (data-count) off) 0 (data off)))
(defn path-x-at [off k] (data (+ 1 off (* 2 k))))
(defn path-y-at [off k] (data (+ 2 off (* 2 k))))
(defn path-n [] (path-n-at 0))
(defn path-x [k] (path-x-at 0 k))
(defn path-y [k] (path-y-at 0 k))
;; Ray-cast crossing test for the edge (k, k+1).
(defn path-cross-edge-at [px py off k n]
  (let [k1 (mod (+ k 1) (max n 1))
        x0 (path-x-at off k) y0 (path-y-at off k)
        x1 (path-x-at off k1) y1 (path-y-at off k1)]
    (if (all2 (any2 (all2 (<= y0 py) (> y1 py)) (all2 (<= y1 py) (> y0 py)))
              (< px (+ x0 (/ (* (- x1 x0) (- py y0)) (if (= y1 y0) .000001 (- y1 y0))))))
      1 0)))
;; Winding-number contribution for the edge (k, k+1).
(defn path-wind-edge-at [px py off k n]
  (let [k1 (mod (+ k 1) (max n 1))
        x0 (path-x-at off k) y0 (path-y-at off k)
        x1 (path-x-at off k1) y1 (path-y-at off k1)
        cross (- (* (- x1 x0) (- py y0)) (* (- px x0) (- y1 y0)))]
    (if (<= y0 py)
      (if (> y1 py) (if (> cross 0) 1 0) 0)
      (if (<= y1 py) (if (< cross 0) -1 0) 0))))
(defn path-crossings-at [px py off n] (sum k 0 n (path-cross-edge-at px py off k n)))
(defn path-winding-at [px py off n] (sum k 0 n (path-wind-edge-at px py off k n)))
;; rule 0 = nonzero, 1 = even-odd.
(defn path-inside-at [px py off n rule]
  (if (= rule 0) (if (= (path-winding-at px py off n) 0) 0 1)
    (if (= (mod (path-crossings-at px py off n) 2) 1) 1 0)))
(defn path-inside [px py n rule] (path-inside-at px py 0 n rule))
;; Distance from a point to a segment.
(defn dist-to-seg [px py x0 y0 x1 y1]
  (let [dx (- x1 x0) dy (- y1 y0) len2 (+ (* dx dx) (* dy dy))
        t (if (= len2 0) 0 (clamp01 (/ (+ (* (- px x0) dx) (* (- py y0) dy)) len2)))
        cx (+ x0 (* t dx)) cy (+ y0 (* t dy))]
    (sqrt (+ (* (- px cx) (- px cx)) (* (- py cy) (- py cy))))))
;; Union coverage of a stroked outline (half-width and aa in normalized units).
(defn path-stroke-cover-at [px py off n halfwidth aa]
  (min 1 (sum k 0 n
    (let [k1 (mod (+ k 1) (max n 1))]
      (clamp01 (/ (- halfwidth (dist-to-seg px py (path-x-at off k) (path-y-at off k)
                                            (path-x-at off k1) (path-y-at off k1)))
                  (max aa .000001)))))))

;; ---------------------------------------------------------------------------
;; Second-frame accessor. Multi-frame kernels pass the "other" frame through the
;; resource array as width*height*4 floats; empty data degrades to the source.
(defn to-frame [x y c]
  (if (= (data-count) 0) (pixel x y c) (data (+ (* 4 (+ (* y width) x)) c))))

;; ---------------------------------------------------------------------------
;; Per-cell values. The profile has no fold primitive, so a nearest-cell search
;; is expressed as an exponentially weighted average over the 3x3 neighbourhood:
;; at sharpness `k` it approaches a true nearest-cell pick.
(defn worley-soft [x y seed k]
  (let [xi (floor x) yi (floor y)]
    (let [ws (sum i -1 2 (sum j -1 2 (exp (- k (worley-cell x y (+ xi i) (+ yi j) seed)))))]
      (if (<= ws .000001) 0
        (/ (sum i -1 2 (sum j -1 2
              (let [cx (+ xi i) cy (+ yi j)]
                (* (exp (- k (worley-cell x y cx cy seed))) (hash2 cx cy seed)))))
           ws)))))
;; Per-cell feature-point offset, used for facet normals and dot placement.
(defn worley-soft-x [x y seed k]
  (let [xi (floor x) yi (floor y)]
    (let [ws (sum i -1 2 (sum j -1 2 (exp (- k (worley-cell x y (+ xi i) (+ yi j) seed)))))]
      (if (<= ws .000001) 0
        (/ (sum i -1 2 (sum j -1 2
              (let [cx (+ xi i) cy (+ yi j)]
                (* (exp (- k (worley-cell x y cx cy seed))) (+ cx (hash2 cx cy seed))))))
           ws)))))
(defn worley-soft-y [x y seed k]
  (let [xi (floor x) yi (floor y)]
    (let [ws (sum i -1 2 (sum j -1 2 (exp (- k (worley-cell x y (+ xi i) (+ yi j) seed)))))]
      (if (<= ws .000001) 0
        (/ (sum i -1 2 (sum j -1 2
              (let [cx (+ xi i) cy (+ yi j)]
                (* (exp (- k (worley-cell x y cx cy seed))) (+ cy (hash2 cx cy (+ seed 1)))))))
           ws)))))
;; Neighbourhood min/max of the alpha channel, used by matte erosion/dilation.
;; Min/max of the alpha channel over a (2r+1)^2 neighbourhood. There is no fold
;; primitive, so the max is expressed as 1 minus the mean of (1 - alpha).
(defn alpha-min [x y r]
  (/ (sum i (- r) (+ r 1) (sum j (- r) (+ r 1) (sample (+ x i) (+ y j) 3 0 1)))
     (* (+ (* 2 r) 1) (+ (* 2 r) 1))))
(defn alpha-max [x y r]
  (- 1 (/ (sum i (- r) (+ r 1) (sum j (- r) (+ r 1) (- 1 (sample (+ x i) (+ y j) 3 0 1))))
           (* (+ (* 2 r) 1) (+ (* 2 r) 1)))))
(defn box-blur [x y c r]
  (/ (sum i (- r) (+ r 1) (sum j (- r) (+ r 1) (sample (+ x i) (+ y j) c 1 1)))
     (* (+ (* 2 r) 1) (+ (* 2 r) 1))))

;; ---------------------------------------------------------------------------
;; ColorMap data: data[0] = entry count N, then N RGB triples in [0,1] ordered
;; dark -> light. Sampling is piecewise-constant so endpoints are exact.
(defn colormap-n [] (if (<= (data-count) 1) 0 (data 0)))
(defn colormap-at [k c] (data (+ 1 (* 3 k) c)))
(defn colormap-value [t c]
  (let [n (colormap-n)]
    (if (< n 1) 0
      (if (= n 1) (colormap-at 0 c)
        ;; piecewise-constant: entry k owns [k/n,(k+1)/n), and t=1 clamps to the
        ;; last entry. The value is taken as-is rather than weighted by the bucket
        ;; width, which is what an interpolated ramp would need but a lookup must
        ;; not do -- weighting made the second entry unreachable at n=2.
        (if (>= t 1) (colormap-at (- n 1) c)
          (sum k 0 n
            (let [x0 (* (/ 1.0 n) k)
                  x1 (* (/ 1.0 n) (+ k 1))]
              (if (all2 (>= t x0) (< t x1)) (colormap-at k c) 0))))))))
;; ---------------------------------------------------------------------------
;; Grading helpers. These drive the grade_*_vs_* family: a curve's domain is
;; source hue, saturation or luminance, and its range remaps the same quantity.
;; Hue in [0,6) of the source pixel, normalized to the [0,1] curve domain.
(defn hue-unit [x y] (/ (hue (straight x y 0) (straight x y 1) (straight x y 2)) 6))
;; Rotate the pixel's hue by `delta` sectors, keeping its value range.
(defn hue-shift [x y c delta]
  (if (= c 3) (pixel x y 3)
    (let [r (straight x y 0) g (straight x y 1) b (straight x y 2)
          lo (min r (min g b)) hi (max r (max g b))
          h (wrap (+ (hue r g b) delta) 6)]
      (+ lo (* (- hi lo) (hue-component h c))))))
;; Force HSV saturation to `target` while holding luminance.
(defn sat-set [x y c target]
  (if (= c 3) (pixel x y 3)
    (let [r (straight x y 0) g (straight x y 1) b (straight x y 2)
          l (luma r g b)]
      (+ l (* (- (channel c r g b) l) target)))))
;; Set luminance to `target`, scaling RGB uniformly about black.
(defn luma-set [x y c target]
  (if (= c 3) (pixel x y 3)
    (let [r (straight x y 0) g (straight x y 1) b (straight x y 2)
          l (max .000001 (luma r g b)) k (/ target l)]
      (* (channel c r g b) k))))

;; ---------------------------------------------------------------------------
;; Multi-frame resources. `frame-count` frames are packed back to back, each one
;; width*height*4 floats. An out-of-range index falls back to the source, so a
;; caller may supply fewer frames than a kernel asks for.
(defn frame-size [] (* 4 (* width height)))
(defn frame-count []
  (let [fs (frame-size)] (if (= fs 0) 0 (floor (/ (data-count) fs)))))
(defn frame-at [k x y c]
  (let [idx (+ (* 4 (+ (* y width) x)) c)]
    (if (all2 (>= k 0) (< k (frame-count))) (data (+ (* k (frame-size)) idx)) (pixel x y c))))
(defn frame-clamped [k x y c]
  (frame-at (max 0 (min (- (frame-count) 1) k)) x y c))

;; ---------------------------------------------------------------------------
;; Single-channel plane resources (matte, mask, map). A plane is width*height
;; floats; a two-plane resource is two such planes back to back. Reading past the
;; end returns 1, i.e. fully opaque, which is the safe default for a matte.
(defn plane-count [] (/ (data-count) (max 1 (* width height))))
(defn plane-at [p x y]
  (let [idx (+ (* y width) x)]
    (if (all2 (>= p 0) (< p (plane-count))) (data (+ (* p (* width height)) idx)) 1)))

;; ---------------------------------------------------------------------------
;; Audio resources. data[0] = sample count M, then M mono samples in [-1,1].
;; There is no complex type, so the spectrum uses a real DFT over sin/cos.
(defn audio-count [] (if (> (data-count) 1) (max 1 (round (data 0))) 0))
(defn audio-at [i] (if (all2 (>= i 0) (< i (audio-count))) (data (+ 1 i)) 0))
(defn audio-rms []
  (if (= (audio-count) 0) 0
    (/ (sqrt (sum i 0 (audio-count) (* (audio-at i) (audio-at i)))) (audio-count))))
(defn audio-peak []
  (if (= (audio-count) 0) 0
    (/ (sum i 0 (audio-count) (abs (audio-at i))) (audio-count))))
;; The magnitude of DFT bin k, normalised to [-1,1]. There is no complex type in
;; the profile, so the real and imaginary parts are accumulated separately. This
;; is a direct transform, not a fast one: it costs O(M) trig calls per bin, so
;; kernels using it are marked @gpu No.
(defn audio-bin [k]
  (let [m (audio-count)]
    (if (all2 (>= k 1) (> m k))
      (let [re (sum i 0 m (* (audio-at i) (cos (* (/ (* 2 pi k) m) i))))
            im (sum i 0 m (* (audio-at i) (sin (* (/ (* 2 pi k) m) i))))]
        (/ (sqrt (+ (* re re) (* im im))) (* 0.5 m)))
      0)))
