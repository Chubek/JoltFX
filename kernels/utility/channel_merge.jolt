;; @kernel       channel_merge
;; @category     utility
;; @description  Combines separate channel frames into a single multi-channel frame.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (ignored); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.utility; shared functions: common/image.jolt.
;; channel 0 source; 0 src, 1 data0, 2 data1, 2 data2, 3 data3; range [0, 3].
(param channel_0_src 0 0 3 1)
;; channel 1 source; range [0, 3].
(param channel_1_src 1 0 3 1)
;; channel 2 source; range [0, 3].
(param channel_2_src 2 0 3 1)
;; channel 3 source; range [0, 3].
(param channel_3_src 3 0 3 1)
;; output format; 0 RGBA, 1 RGB, 2 RG; range [0, 2].
(param output_format 0 0 2 1)


(defkernel channel_merge [x y c]
  (pixel x y c))