;; @kernel       channel_merge
;; @category     utility
;; @description  Combines separate channel frames into a single multi-channel frame.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.utility; shared functions: common/image.jolt.
;; The resource array holds up to four single-channel planes of width*height,
;; concatenated. Each output channel selects the source frame or one plane.
;; channel 0 source; 0 src, 1..4 plane 0..3; range [0, 4].
(param channel_0_src 0 0 4 1)
;; channel 1 source; range [0, 4].
(param channel_1_src 1 0 4 1)
;; channel 2 source; range [0, 4].
(param channel_2_src 2 0 4 1)
;; channel 3 source; range [0, 4].
(param channel_3_src 3 0 4 1)
;; output format; 0 RGBA, 1 RGB, 2 RG; range [0, 2].
(param output_format 0 0 2 1)


(defkernel channel_merge [x y c]
  (let [plane (* width height)
        sel (if (= c 0) channel_0_src (if (= c 1) channel_1_src (if (= c 2) channel_2_src channel_3_src)))
        v (if (= sel 0) (pixel x y c)
            (if (= (data-count) 0) (pixel x y c)
              (data (+ (* (- sel 1) plane) (* y width) x))))]
    (if (= c 3)
      (if (= output_format 0) v (if (= output_format 1) 1 1))
      v)))
