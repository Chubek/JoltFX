;; @kernel       remap_range
;; @category     utility
;; @description  Linearly remaps input values from one numeric interval to another.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.utility; shared functions: common/image.jolt.
;; input range minimum; range [-10, 10].
(param input_min 0 -10 10 0)
;; input range maximum; range [-10, 10].
(param input_max 1 -10 10 0)
;; output range minimum; range [-10, 10].
(param output_min 0 -10 10 0)
;; output range maximum; range [-10, 10].
(param output_max 1 -10 10 0)
;; clamp output to output range; range [0, 1].
(param clamp 0 0 1 1)
;; 0 all, 1 RGB, 2 RGBA, 3 alpha only; range [0, 3].
(param channels 1 0 3 1)


(defn remap-applies [channels c]
  (if (= channels 0) 1
    (if (= channels 1) (if (= c 3) 0 1)
      (if (= channels 2) (if (= c 3) 1 0)
        (if (= c 3) 1 (if (= c (- channels 1)) 1 0))))))


(defkernel remap_range [x y c]
  (let [v (pixel x y c)
        ;; clamp the input window before scaling, so out-of-range values do not
        ;; extrapolate into the output range
        t (clamp01 (/ (- v input_min) (max .000001 (- input_max input_min))))
        out (+ output_min (* t (- output_max output_min)))
        ;; channel 4 maps the alpha, 0 maps colour and alpha alike
        apply (remap-applies channels c)
        out2 (if (= clamp 1) (min output_max (max output_min out)) out)]
    (finish (if (= apply 1) out2 v) (pixel x y 3) 0)))
