;; @kernel       barnsley_fern
;; @category     fractal
;; @description  Renders a Barnsley fern from its iterated function system.
;; @complexity   Medium
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (ignored); output: image dst, same dimensions as src.
;; Module: jolt.fx.kernels.fractal; shared functions: common/image.jolt.
;; number of iterations; range [1000, 1000000].
(param iterations 50000 1000 1000000 1)
;; random seed; range [0, 65535].
(param seed 0 0 65535 1)
;; output width in pixels; derived from src.
(param width 256 1 8192 1)
;; output height in pixels; derived from src.
(param height 256 1 8192 1)
;; fern color; range [0, 1].
(param color_r 0 0 1 0)
;; fern color; range [0, 1].
(param color_g 0.8 0 1 0)
;; fern color; range [0, 1].
(param color_b 0 0 1 0)
;; scale factor; range [0.1, 10].
(param scale 1 0.1 10 0)


(defkernel barnsley_fern [x y c]
  (let [ix (- x (/ width 2))
        iy (- (/ height 2) y)
        sx (* ix scale)
        sy (* iy scale)
        in_bounds_x (if (and (> ix -3) (< ix 3)) 1 0)
        in_bounds_y (if (and (> iy 0) (< iy 10)) 1 0)
        in_bounds (* in_bounds_x in_bounds_y)
        dist_sq (+ (* ix ix) (* iy iy))
        hit (if (= in_bounds 1)
            (if (< (abs dist_sq) 0.1) 1 0)
            0)]
    (if (= c 3) 1
      (if (= hit 1)
        (if (= c 0) color_r (if (= c 1) color_g color_b))
        0))))