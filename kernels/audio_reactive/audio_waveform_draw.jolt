;; @kernel       audio_waveform_draw
;; @category     audio_reactive
;; @description  Draws an audio waveform into a frame over a selected time window.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (background, premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.audio_reactive; shared functions: common/image.jolt.
;; Audio resource layout (the shared audio-* helpers):
;;   data[0]      = sample count M
;;   data[1 .. M] = M mono samples in [-1,1]
;; Each output column shows the sample at a window position, drawn as a filled band
;; about the centre line with a bright trace on the envelope. audio-at degrades to
;; zero outside the window, so any sample index is safe.
;; first sample of the displayed window; range [0, 65536].
(param window_offset 0 0 65536 1)
;; number of samples displayed across the frame; range [1, 65536].
(param sample_count 512 1 65536 1)
;; band half height as a fraction of frame height; range [0.02, 1].
(param thickness 0.35 0.02 1 0)
;; centre line y in normalized frame coordinates; range [0, 1].
(param position_y 0.5 0 1 0)
;; waveform opacity; range [0, 1].
(param opacity 1 0 1 0)

(defkernel audio_waveform_draw [x y c]
  (if (= c 3) (pixel x y 3)
    (let [span (max 1 sample_count)
          idx (max 0 (+ window_offset (floor (* (/ x (max 1 width)) span))))
          amp (audio-at idx)
          cy (* position_y height)
          half (* thickness height)
          ; the band is filled from the centre line out to the sample envelope
          lift (* amp half)
          dy (- y cy)
          fill (clamp01 (/ (- (max 0 (abs lift)) (abs dy)) (max 1 (* half .05))))
          trace (clamp01 (/ (- 1 (* 12 (abs (- dy lift)))) 1))
          ; the centre line keeps the amplitude readable against the picture
          axis (clamp01 (/ (- 1 (* 3 (abs dy))) 1))
          basec (channel c (straight x y 0) (straight x y 1) (straight x y 2))
          bandc (channel c .20 .80 .55)
          tracec (channel c .92 1 .96)
          axisc (channel c .55 .60 .65)
          amt (min 1 (* opacity (max fill (* .5 axis))))]
      (finish (+ basec
                 (* (* opacity axis) axisc)
                 (* amt (max bandc tracec))
                 (* (* opacity trace) tracec))
              (pixel x y 3)
              0))))
