;; @kernel       video_noise_grain
;; @category     video_effects
;; @description  Adds film grain noise to the frame.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.video_effects; shared functions: common/image.jolt.
;; grain amount; range [0, 1].
(param amount 0.1 0 1 0)
;; grain size in pixels; range [0.5, 8].
(param size 1 0.5 8 0)
;; 0 RGB noise, 1 monochrome; range [0, 1].
(param monochrome 1 0 1 1)
;; random seed; range [0, 65535].
(param seed 0 0 65535 1)
;; animate grain; range [0, 1].
(param animate 0 0 1 1)


(defkernel video_noise_grain [x y c]
  (let [sx (/ x size)
        sy (/ y size)
        g (if (= monochrome 1)
            (hash2 sx sy seed)
            (if (= c 0) (hash2 sx sy seed)
              (if (= c 1) (hash2 sx sy seed)
                (hash2 sx sy seed))))]
    (let [val (pixel x y c)
          grain (* amount (- (* 2 g) 1))]
      (if (= c 3) (pixel x y 3)
        (min 1 (max 0 (+ val grain)))))))