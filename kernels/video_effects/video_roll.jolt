;; @kernel       video_roll
;; @category     video_effects
;; @description  Creates vertical roll bar effect.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.video_effects; shared functions: common/image.jolt.
;; A soft-edged horizontal band sits at position * height and is measured on a
;; wrapped height axis, so the band reappears on the opposite edge once it has
;; rolled off the bottom. Inside the band the picture is read `amount` pixels lower
;; with a wrapping source row, which is a roll bar travelling down the raster; alpha
;; rolls with the colour so the smear stays consistent across the frame.
;; band centre as a fraction of the frame height; range [0, 1].
(param position 0.5 0 1 0)
;; band half width as a fraction of the frame height; range [0.001, 1].
(param band_width 0.08 0.001 1 0)
;; band edge softness as a fraction of the half width; range [0.01, 1].
(param softness 0.6 0.01 1 0)
;; vertical displacement at the band centre in pixels; range [0, 256].
(param amount 48 0 256 0)
;; animate; 0 a frozen bar, 1 the bar drifts down every pass; range [0, 1].
(param animate 1 0 1 1)


(defkernel video_roll [x y c]
  (let [hw (max 0.5 (* band_width height))
        soft (max 0.0001 (* softness hw))
        ;; band centre, wrapping once it has rolled off the bottom
        cy (wrap (+ (* position height) (if (= animate 1) (* pass 1.5) 0)) height)
        ;; distance to the band on the wrapped height axis
        raw (abs (- y cy))
        d (min raw (- height raw))
        band (clamp01 (/ (- (+ hw soft) d) (* 2 soft)))
        sy (wrap (+ y (* band amount)) height)]
    (sample x sy c 1 1)))