;; @kernel       video_mosaic
;; @category     video_effects
;; @description  Creates mosaic block effect with configurable size.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.video_effects; shared functions: common/image.jolt.
;; block size in pixels; range [1, 128].
(param block_size 8 1 128 1)
;; grout width in pixels; range [0, 16].
(param grout_width 1 0 16 0)
;; grout color red; range [0, 1].
(param grout_r 0 0 1 0)
;; grout color green; range [0, 1].
(param grout_g 0 0 1 0)
;; grout color blue; range [0, 1].
(param grout_b 0 0 1 0)
;; shape; 0 square, 1 hex; range [0, 1].
(param shape 0 0 1 1)


(defkernel video_mosaic [x y c]
  (pixel x y c))