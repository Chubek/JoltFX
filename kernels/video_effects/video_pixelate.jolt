;; @kernel       video_pixelate
;; @category     video_effects
;; @description  Creates pixelation effect with block size.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.video_effects; shared functions: common/image.jolt.
;; pixel block size; range [1, 128].
(param block_size 8 1 128 1)
;; 0 square, 1 rectangular; range [0, 1].
(param shape 0 0 1 1)
;; animate pixelation; range [0, 1].
(param animate 0 0 1 1)


(defkernel video_pixelate [x y c]
  (let [bs block_size
        ;; animate drifts the sampling lattice so the pixel grid crawls
        drift (if (= animate 1) (mod pass 2) 0)
        sx (* drift bs)
        bx (* bs (floor (/ (+ x sx) bs)))
        by (* bs (floor (/ y bs)))
        ;; shape 1 rounds each tile off, which reads as circular dabs
        gx (- x (+ sx bx))
        gy (- y by)
        dx (- gx (/ bs 2))
        dy (- gy (/ bs 2))
        rad (if (= shape 1) (/ bs 2) (+ bs 1))
        inside (if (= shape 1)
                 (if (<= (+ (* dx dx) (* dy dy)) (* rad rad)) 1 0)
                 1)
        val (sample bx by c 0 1)]
    (* val inside)))