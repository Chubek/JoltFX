;; @kernel       text_path
;; @category     text
;; @description  Places glyphs along a path and renders the resulting text frame.
;; @complexity   High
;; @gpu          Partial
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (background, premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.text; shared functions: common/image.jolt.
;; Text run resource layout (the profile has no string or font type, so the text
;; engine supplies the rasterised run):
;;   data[0]         = glyph count N
;;   data[1 .. N]    = per-glyph character code
;;   data[N+1 .. 2N] = per-glyph advance width, in run-box widths
;;   data[2N+1 .. ]  = glyph coverage plane, width*height floats
;; The path is packed immediately after the run, at offset 1 + 2N + width*height,
;; and is read with the offset forms of the path-* helpers:
;;   data[po]      = vertex count P
;;   data[po+1 .. po+2P] = P (x,y) pairs in normalized [0,1] frame coordinates
;; The run coordinate is mapped onto the path arc length, so the glyphs bend with
;; the path and stretch to its length. Every read is guarded, so an absent path or
;; run resource is a no-op.
;; glyph code page selector, which folds the character codes onto a tint:
;; 0 straight codes, 1 upper-case fold, 2 digits-only fold, 3 symbol fold.
;; range [0, 3].
(param character_set 0 0 3 1)
;; font weight variant: 0 regular, 1 bold (widen the cross coordinate),
;; 2 condensed (narrow it). range [0, 2].
(param font_variant 0 0 2 1)
;; distance to shift the run along the path, in path lengths; range [-2, 2].
(param offset 0 -2 2 0)
;; 0 lays the run along the path, 1 lays it against the path; range [0, 1].
(param reverse 0 0 1 1)

;; ---------------------------------------------------------------------------
;; Rasterised text run resource, shared accessors. The image profile has no
;; string or font type, so the text engine hands the kernel the glyph run it has
;; already rasterised:
;;   data[0]         = glyph count N
;;   data[1 .. N]    = per-glyph character code
;;   data[N+1 .. 2N] = per-glyph advance width, in run-box widths
;;   data[2N+1 .. ]  = glyph coverage plane, width*height floats
;; The plane is a frame-sized rasterisation of the run, so a run box placed in the
;; frame samples it: one rasterised run can be placed, scaled and recoloured
;; without re-rasterising. Every read below is guarded, so an absent (empty)
;; resource degrades to a no-op instead of failing.

;; Glyph count, bounded by the array actually supplied.
(defn run-n []
  (if (> (data-count) 2)
    (max 0 (min (round (data 0)) (floor (/ (- (data-count) 1) 2))))
    0))

;; Advance of glyph j, expressed in run-box widths.
(defn text-advance [j]
  (let [n (run-n)]
    (if (all2 (> n 0) (all2 (< j n) (< (+ (+ n 1) j) (data-count)))) (data (+ (+ n 1) j)) 0)))

;; Index of the glyph covering run coordinate u: the number of glyph start edges
;; at or before u, minus one.
(defn text-glyph-at [u n]
  (max 0 (min (- n 1) (sum i 0 n
    (if (< u (sum j 0 i (text-advance j))) 0 1)))))

;; Left and right edges of glyph i, and the extent of the whole run.
(defn glyph-left [i] (sum j 0 i (text-advance j)))
(defn glyph-right [i] (+ (glyph-left i) (text-advance i)))
(defn text-extent [] (glyph-left (run-n)))

;; Coverage plane index for run-box coordinates (u,v), or -1 outside the run.
(defn run-index [u v]
  (let [n (run-n)
        p (+ 1 (* 2 n))
        w (max 1 width)
        h (max 1 height)
        i (+ (* (floor (* v h)) w) (floor (* u w)))]
    (if (all2 (>= u 0) (all2 (< u 1) (all2 (>= v 0) (all2 (< v 1) (< (+ p i) (data-count))))))
      (+ p i)
      -1)))

;; Coverage of the run at run-box coordinates (u,v).
(defn run-coverage [u v]
  (let [i (run-index u v)] (if (< i 0) 0 (max 0 (data i)))))

;; Coverage of the run at frame pixel (x,y), given the run box top-left and size
;; in pixels. This is the entry point every text kernel samples through.
(defn text-coverage [x y ox oy boxw boxh]
  (let [n (run-n)]
    (if (< n 1) 0
      (run-coverage (/ (- x ox) (max .0001 boxw)) (/ (- y oy) (max .0004 boxh))))))

;; Ink of the run box counting only glyphs at or below `revealed`. The glyph
;; index lookup is quadratic in the glyph count, so it is gated on real coverage.
(defn text-reveal-coverage [x y ox oy boxw boxh revealed]
  (let [cv (text-coverage x y ox oy boxw boxh)]
    (if (> cv 0)
      (let [n (run-n) u (/ (- x ox) (max .0001 boxw))]
        (if (all2 (> n 0) (<= (text-glyph-at u n) revealed)) cv 0))
      0)))

(defkernel text_path [x y c]
  (if (= c 3) (pixel x y 3)
    (let [n (run-n)
          po (+ 1 (+ (* 2 (run-n)) (* width height)))
          p (max 0 (min (round (path-n-at po)) 4096))
          u (/ x (max 1 width))
          v (/ y (max 1 height))
          ; the nearest-path-point search is an exponentially weighted average over
          ; the segments, which is how the profile expresses a nearest-cell pick
          k 220
          ws (if (> p 1) (sum i 0 (- p 1)
                (let [i1 (+ i 1)]
                  (exp (- k (dist-to-seg u v (path-x-at po i) (path-y-at po i)
                                        (path-x-at po i1) (path-y-at po i1)))))) 0)
          ; arc length at the foot of the perpendicular onto segment i
          pre (if (> p 1) (sum i 0 (- p 1)
                (let [j1 (+ i 1)
                      ex (- (path-x-at po j1) (path-x-at po i)) ey (- (path-y-at po j1) (path-y-at po i))]
                  (sqrt (+ (* ex ex) (* ey ey))))) 0)
          ; weighted average of the along-path distance and the signed side offset
          along (if (> ws .000001)
                (/ (sum i 0 (- p 1)
                     (let [i1 (+ i 1)
                           x0 (path-x-at po i) y0 (path-y-at po i)
                           x1 (path-x-at po i1) y1 (path-y-at po i1)
                           dx (- x1 x0) dy (- y1 y0)
                           len (sqrt (+ (* dx dx) (* dy dy)))
                           den (max .000001 (+ (* dx dx) (* dy dy)))
                           t (/ (+ (* (- u x0) dx) (* (- v y0) dy)) den)
                           w (exp (- k (dist-to-seg u v x0 y0 x1 y1)))]
                       (* w (+ pre (* t len)))))
                   ws)
                0)
          total (if (> p 1) (sum i 0 (- p 1)
                (let [i1 (+ i 1)
                      ex (- (path-x-at po i1) (path-x-at po i)) ey (- (path-y-at po i1) (path-y-at po i))]
                  (sqrt (+ (* ex ex) (* ey ey))))) 0)
          side (if (> ws .000001)
                (/ (sum i 0 (- p 1)
                     (let [i1 (+ i 1)
                           x0 (path-x-at po i) y0 (path-y-at po i)
                           x1 (path-x-at po i1) y1 (path-y-at po i1)
                           dx (- x1 x0) dy (- y1 y0)
                           len (max .000001 (sqrt (+ (* dx dx) (* dy dy))))
                           s (/ (- (* (- u x0) dy) (* (- v y0) dx)) len)
                           w (exp (- k (dist-to-seg u v x0 y0 x1 y1)))]
                       (* w s)))
                   ws)
                0)
          frac (if (> total .000001) (/ along total) 0)
          dirn (if (= reverse 1) -1 1)
          ru (mod (+ (* dirn frac) offset) 1)
          ; the run is laid out across a band centred on the path; the font variant
          ; sets how tall that band is, which widens or narrows the glyphs
          bandn (if (= font_variant 1) .028 (if (= font_variant 2) .07 .045))
          rv (clamp01 (+ .5 (/ side bandn)))
          code (if (> n 0) (data (+ 1 (max 0 (min (- n 1) (text-glyph-at ru n))))) 0)
          folded (if (= character_set 0) code
                  (if (= character_set 1) (* (mod code 26) 65)
                    (if (= character_set 2) (* (mod code 10) 48) (* (mod (+ code 11) 40) 32))))
          tint (mod folded 3)
          a (if (> n 1) (clamp01 (run-coverage ru rv)) 0)
          base (channel c (straight x y 0) (straight x y 1) (straight x y 2))
          ir (if (= tint 0) 1 (if (= tint 1) .40 .30))
          ig (if (= tint 0) 1 (if (= tint 1) .92 .70))
          ib (if (= tint 0) 1 (if (= tint 1) .30 .95))]
      (finish (mix base (channel c ir ig ib) a) (pixel x y 3) 1))))