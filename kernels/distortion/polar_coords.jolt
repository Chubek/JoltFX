;; @kernel       polar_coords
;; @category     distortion
;; @description  Reprojects an image between polar coordinates and Cartesian coordinates.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.distortion; shared functions: common/image.jolt.
;; 0 forward (Cartesian to polar), 1 inverse (polar to Cartesian); range [0, 1].
(param inverse 0 0 1 1)
;; normalized center coordinates; range [-4, 4].
(param center_x 0.5 -4 4 0)
;; normalized center coordinates; range [-4, 4].
(param center_y 0.5 -4 4 0)
;; radius as fraction of min dimension; range [0.01, 4].
(param radius 1 0.01 4 0)
;; angle offset in degrees; range [-360, 360].
(param angle_offset 0 -360 360 0)
;; 0 nearest, 1 bilinear; range [0, 1].
(param interpolation 1 0 1 1)


(defkernel polar_coords [x y c]
  (let [cx (- (* center_x width) .5)
        cy (- (* center_y height) .5)
        r_max (* radius (min width height) .5)
        dx (- x cx)
        dy (- y cy)
        dist (sqrt (+ (* dx dx) (* dy dy)))
        angle (atan2 dy dx)]
    (if (= inverse 0)
      ;; Forward: Cartesian -> Polar
      (let [polar_x (/ (+ angle (radians angle_offset)) (* 2 pi))
            polar_y (/ dist r_max)]
        (sample polar_x polar_y c interpolation 0))
      ;; Inverse: Polar -> Cartesian
      (let [theta (- (* x (* 2 pi)) (radians angle_offset))
            r (* y r_max)
            sx (+ cx (* r (cos theta)))
            sy (+ cy (* r (sin theta)))]
        (sample sx sy c interpolation 0)))))