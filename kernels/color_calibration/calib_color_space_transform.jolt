;; @kernel       calib_color_space_transform
;; @category     color_calibration
;; @description  Converts between color spaces.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_calibration; shared functions: common/image.jolt.
;; 0 sRGB, 1 linear, 2 Rec.709, 3 Rec.2020, 4 Display P3; range [0, 4].
(param input_space 0 0 4 1)
;; 0 sRGB, 1 linear, 2 Rec.709, 3 Rec.2020, 4 Display P3; range [0, 4].
(param output_space 1 0 4 1)
;; adaptation; 0 none, 1 Bradford, 2 von Kries; range [0, 2].
(param adaptation 0 0 2 1)
;; clamp output; range [0, 1].
(param clamp 1 0 1 1)


(defkernel calib_color_space_transform [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (straight x y 0)
          g (straight x y 1)
          b (straight x y 2)
          lr (to-linear-channel input_space r g b 0)
          lg (to-linear-channel input_space r g b 1)
          lb (to-linear-channel input_space r g b 2)
          v (from-linear-channel output_space lr lg lb c)]
      (finish v (pixel x y 3) (if (= clamp 1) 1 0)))))
