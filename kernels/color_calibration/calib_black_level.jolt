;; @kernel       calib_black_level
;; @category     color_calibration
;; @description  Calibrates black level to correct offset.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_calibration; shared functions: common/image.jolt.
;; black level offset; range [-1, 1].
(param black_level 0 -1 1 0)
;; channel; 0 RGB, 1 R, 2 G, 3 B, 4 A; range [0, 4].
(param channel 0 0 4 1)
;; clamp output; range [0, 1].
(param clamp 1 0 1 1)
;; preserve shadows; range [0, 1].
(param preserve_shadows 1 0 1 1)


(defkernel calib_black_level [x y c]
  (if (= c 3) (pixel x y 3)
    (pixel x y c)))