;; @kernel       calib_srgb_to_display_p3
;; @category     color_calibration
;; @description  Converts sRGB to Display P3 color space.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_calibration; shared functions: common/image.jolt.
;; clamp output; range [0, 1].
(param clamp 1 0 1 1)
;; conversion strength; 0 passes the source through, 1 fully converts; range [0, 1].
(param strength 1 0 1 0)
;; preserve luminance; range [0, 1].
(param preserve_luma 1 0 1 1)


(defkernel calib_srgb_to_display_p3 [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (decode (straight x y 0))
          g (decode (straight x y 1))
          b (decode (straight x y 2))
          l (luma r g b)
          nr (srgb-to-p3 r g b 0)
          ng (srgb-to-p3 r g b 1)
          nb (srgb-to-p3 r g b 2)
          adj (if (= preserve_luma 1) (- l (luma nr ng nb)) 0)
          v (encode (max 0 (+ (channel c nr ng nb) adj)))]
      (finish (mix (straight x y c) v strength) (pixel x y 3) (if (= clamp 1) 1 0)))))
