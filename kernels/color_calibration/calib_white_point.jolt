;; @kernel       calib_white_point
;; @category     color_calibration
;; @description  Calibrates white point to correct gain.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_calibration; shared functions: common/image.jolt.
;; white point gain; range [0.1, 8].
(param white_point 1 0.1 8 0)
;; channel; 0 RGB, 1 R, 2 G, 3 B, 4 A; range [0, 4].
(param channel 0 0 4 1)
;; clamp output; range [0, 1].
(param clamp 1 0 1 1)
;; preserve highlights; range [0, 1].
(param preserve_highlights 1 0 1 1)


(defkernel calib_white_point [x y c]
  (if (= c 3) (pixel x y 3)
    (let [apply (or (= channel 0) (or (= channel 1) (= channel (+ c 1))))
          v (straight x y c)
          gain (if (and (= preserve_highlights 1) (> v .9)) 1 white_point)
          out (* v gain)]
      (finish (if apply out v) (pixel x y 3) (if (= clamp 1) 1 0)))))
