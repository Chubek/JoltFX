;; @kernel       grade_film_emulation
;; @category     color_grading
;; @description  Emulates film stock characteristics.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_grading; shared functions: common/image.jolt.
;; film stock; 0 kodak, 1 fuji, 2 agfa; range [0, 2].
(param film_stock 0 0 2 1)
;; effect intensity; range [0, 1].
(param intensity 0.5 0 1 0)
;; grain amount; range [0, 1].
(param grain 0.1 0 1 0)
;; halation amount; range [0, 1].
(param halation 0.1 0 1 0)


(defkernel grade_film_emulation [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (straight x y 0)
          g (straight x y 1)
          b (straight x y 2)
          l (luma r g b)
          sat (if (= film_stock 0) 1.25 (if (= film_stock 1) 1.35 1.15))
          con (if (= film_stock 0) 1.15 (if (= film_stock 1) 1.1 1.2))
          sr (saturate r g b sat)
          sg (saturate g g b sat)
          sb (saturate b g b sat)
          v (contrast-around (channel c sr sg sb) con .5)
          halo (max 0 (- l .7))
          v2 (+ v (* halation halo .3))
          n (* grain (- (* 2 (hash2 x y film_stock)) 1))]
      (finish (mix (channel c r g b) (clamp01 (+ v2 n)) intensity) (pixel x y 3) 1))))
