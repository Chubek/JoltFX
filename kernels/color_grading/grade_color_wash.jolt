;; @kernel       grade_color_wash
;; @category     color_grading
;; @description  Applies color wash overlay.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_grading; shared functions: common/image.jolt.
;; wash color red; range [0, 1].
(param color_r 0.2 0 1 0)
;; wash color green; range [0, 1].
(param color_g 0.2 0 1 0)
;; wash color blue; range [0, 1].
(param color_b 0.6 0 1 0)
;; wash intensity; range [0, 1].
(param intensity 0.3 0 1 0)
;; blend mode; 0 normal, 1 multiply, 2 screen, 3 overlay; range [0, 3].
(param blend_mode 0 0 3 1)


(defkernel grade_color_wash [x y c]
  (if (= c 3) (pixel x y 3)
    (let [base (straight x y c)
          wash (channel c color_r color_g color_b)
          v (blend-mode blend_mode base wash)]
      (finish (mix base v intensity) (pixel x y 3) 1))))
