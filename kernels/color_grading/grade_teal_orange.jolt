;; @kernel       grade_teal_orange
;; @category     color_grading
;; @description  Applies teal and orange color grading.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_grading; shared functions: common/image.jolt.
;; grading intensity; range [0, 1].
(param intensity 0.5 0 1 0)
;; teal hue in degrees; range [0, 360].
(param teal_hue 180 0 360 0)
;; orange hue in degrees; range [0, 360].
(param orange_hue 30 0 360 0)
;; preserve luminance; range [0, 1].
(param preserve_luma 1 0 1 1)


(defkernel grade_teal_orange [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (straight x y 0)
          g (straight x y 1)
          b (straight x y 2)
          l (luma r g b)
          h (* (hue r g b) 60)
          warm (max 0 (- 1 (/ (min (abs (- h orange_hue)) (- 360 (abs (- h orange_hue)))) 90)))
          cool (max 0 (- 1 (/ (min (abs (- h teal_hue)) (- 360 (abs (- h teal_hue)))) 90)))
          tr (+ 1 (* warm 0.35) (* cool -0.15))
          tg (+ 1 (* warm 0.10) (* cool 0.10))
          tb (+ 1 (* warm -0.20) (* cool 0.40))
          nr (* r tr)
          ng (* g tg)
          nb (* b tb)
          v (mix (channel c r g b) (channel c nr ng nb) intensity)
          adj (if (= preserve_luma 1) (- l (luma (mix r nr intensity) (mix g ng intensity) (mix b nb intensity))) 0)]
      (finish (+ v adj) (pixel x y 3) 1))))
