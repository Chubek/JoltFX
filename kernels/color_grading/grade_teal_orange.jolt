;; @kernel       grade_teal_orange
;; @category     color_grading
;; @description  Applies teal and orange color grading.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_grading; shared functions: common/image.jolt.
;; grading intensity; range [0, 1].
(param intensity 0.5 0 1 0)
;; teal hue in degrees; range [0, 360].
(param teal_hue 180 0 360 0)
;; orange hue in degrees; range [0, 360].
(param orange_hue 30 0 360 0)
;; preserve luminance; range [0, 1].
(param preserve_luma 1 0 1 1)


(defkernel grade_teal_orange [x y c]
  (if (= c 3) (pixel x y 3)
    (pixel x y c)))