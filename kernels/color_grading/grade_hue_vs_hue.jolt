;; @kernel       grade_hue_vs_hue
;; @category     color_grading
;; @description  Adjusts hue based on source hue.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_grading; shared functions: common/image.jolt.
;; The resource array holds a Curve: increasing (x,y) pairs over the unit domain.
;; channel interpolation; 0 linear, 1 hermite; range [0, 1].
(param channel 1 0 1 1)
;; hue remap intensity; range [0, 1].
(param intensity 1 0 1 0)
;; hue rotation offset in degrees; range [-180, 180].
(param hue_rotate 0 -180 180 0)


(defkernel grade_hue_vs_hue [x y c]
  (if (= c 3) (pixel x y 3)
    (let [src (hue-unit x y)
          target (clamp01 (curve-value src channel))
          delta (* (+ (- target src) intensity) 6)
          delta (+ delta (/ hue_rotate 60))]
      (finish (hue-shift x y c delta) (pixel x y 3) 1))))
