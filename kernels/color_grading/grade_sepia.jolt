;; @kernel       grade_sepia
;; @category     color_grading
;; @description  Applies sepia tone effect.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_grading; shared functions: common/image.jolt.
;; sepia intensity; range [0, 1].
(param intensity 0.5 0 1 0)
;; sepia color red; range [0, 1].
(param color_r 1.0 0 1 0)
;; sepia color green; range [0, 1].
(param color_g 0.85 0 1 0)
;; sepia color blue; range [0, 1].
(param color_b 0.65 0 1 0)
;; preserve luminance; range [0, 1].
(param preserve_luma 1 0 1 1)


(defkernel grade_sepia [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (straight x y 0)
          g (straight x y 1)
          b (straight x y 2)
          l (luma r g b)
          sr (* l color_r)
          sg (* l color_g)
          sb (* l color_b)
          v (mix (channel c r g b) (channel c sr sg sb) intensity)
          adj (if (= preserve_luma 1) (- l (luma (mix r sr intensity) (mix g sg intensity) (mix b sb intensity))) 0)]
      (finish (+ v adj) (pixel x y 3) 1))))
