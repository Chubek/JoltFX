;; @kernel       grade_portra
;; @category     color_grading
;; @description  Emulates Portra film stock.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.color_grading; shared functions: common/image.jolt.
;; effect intensity; range [0, 1].
(param intensity 0.5 0 1 0)
;; grain amount; range [0, 1].
(param grain 0.1 0 1 0)
;; warmth adjustment; range [-1, 1].
(param warmth 0.3 -1 1 0)


(defkernel grade_portra [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (straight x y 0)
          g (straight x y 1)
          b (straight x y 2)
          wr (+ 1 (* warmth .15))
          wb (- 1 (* warmth .15))
          v (if (= c 0) (* r wr) (if (= c 1) g (* b wb)))
          n (* grain (- (* 2 (hash2 x y 13)) 1))]
      (finish (mix (channel c r g b) (clamp01 (+ v n)) intensity) (pixel x y 3) 1))))
