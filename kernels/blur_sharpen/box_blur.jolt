;; @kernel       box_blur
;; @category     blur_sharpen
;; @description  Averages neighboring pixels over a rectangular kernel.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.blur_sharpen; shared functions: common/image.jolt.
;; horizontal support radius in pixels; range [0, 64].
(param radius 2 0 64 1)
;; vertical support radius in pixels; range [0, 64].
(param radius_y 2 0 64 1)
;; number of full-frame passes; range [1, 8].
(param iterations 1 1 8 1)
;; 0 transparent, 1 clamp, 2 wrap, 3 mirror; range [0, 3].
(param edge_mode 1 0 3 1)
;; Two separable passes per iteration: horizontal, then vertical.
(passes (* 2 iterations))


(defkernel box_blur [x y c]
  (let [rx (ceil radius) ry (ceil radius_y)]
    (if (= (mod pass 2) 0)
      (if (= rx 0) (pixel x y c)
        (/ (sum i (- rx) (+ rx 1) (sample (+ x i) y c 0 edge_mode)) (* 2 rx)))
      (if (= ry 0) (pixel x y c)
        (/ (sum j (- ry) (+ ry 1) (sample x (+ y j) c 0 edge_mode)) (* 2 ry))))))