;; @kernel       unsharp_mask
;; @category     blur_sharpen
;; @description  Sharpens detail by adding a scaled high-frequency image component.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.blur_sharpen; shared functions: common/image.jolt.
;; blur support radius in pixels; range [0.5, 32].
(param radius 2 0.5 32 0)
;; sharpening strength; range [0, 4].
(param amount 1 0 4 0)
;; minimum high-frequency magnitude to sharpen; range [0, 1].
(param threshold 0 0 1 0)
;; 0 transparent, 1 clamp, 2 wrap, 3 mirror; range [0, 3].
(param edge_mode 1 0 3 1)


(defkernel unsharp_mask [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (ceil radius)
          blurred (/ (sum i (- r) (+ r 1) (sum j (- r) (+ r 1)
                       (sample (+ x i) (+ y j) c 0 edge_mode)))
                     (* 4 r r))
          original (pixel x y c)
          diff (- original blurred)]
      (finish (if (> (abs diff) threshold)
                (+ original (* amount diff))
                original) (pixel x y 3) 0))))