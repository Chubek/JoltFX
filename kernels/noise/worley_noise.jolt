;; @kernel       worley_noise
;; @category     noise
;; @description  Generates cellular noise from distances to randomized feature points.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (ignored); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.noise; shared functions: common/image.jolt.
;; random seed; range [0, 65535].
(param seed 0 0 65535 1)
;; noise scale factor; range [0.01, 10].
(param scale 0.05 0.01 10 0)
;; 0 euclidean, 1 manhattan, 2 chebyshev; range [0, 2].
(param metric 0 0 2 1)
;; 0 distance (F1), 1 cell id hash, 2 F2-F1; range [0, 2].
(param output_mode 0 0 2 1)


(defkernel worley_noise [x y c]
  (let [sx (* x scale)
        sy (* y scale)
        d1 (worley-dist sx sy seed)
        xi (floor sx)
        yi (floor sy)
        d2 (worley-dist (+ sx 0.5) (+ sy 0.5) (+ seed 1))
        val (if (= output_mode 0) (clamp01 d1)
              (if (= output_mode 1) (hash2 xi yi seed)
                (clamp01 (abs (- d2 d1)))))]
    (if (= c 3) 1 val)))
