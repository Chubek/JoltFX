;; @kernel       solid_color
;; @category     generative
;; @description  Generates a frame filled with a constant color.
;; @complexity   Low
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (ignored); output: image dst, same dimensions as src.
;; Module: jolt.fx.kernels.generative; shared functions: common/image.jolt.
;; color red channel; range [0, 1].
(param color_r 0.5 0 1 0)
;; color green channel; range [0, 1].
(param color_g 0.5 0 1 0)
;; color blue channel; range [0, 1].
(param color_b 0.5 0 1 0)
;; color alpha channel; range [0, 1].
(param color_a 1 0 1 0)
;; 0 sRGB, 1 linear; range [0, 1].
(param format 0 0 1 1)


(defkernel solid_color [x y c]
  (if (= c 0) color_r
    (if (= c 1) color_g
      (if (= c 2) color_b color_a))))