;; @kernel       stylize_cartoon
;; @category     stylize
;; @description  Applies cartoon/cel shading effect.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.stylize; shared functions: common/image.jolt.
;; quantization levels; range [2, 16].
(param levels 4 2 16 1)
;; edge threshold; range [0, 1].
(param edge_threshold 0.1 0 1 0)
;; saturation boost; range [0, 2].
(param saturation 1.3 0 2 0)


(defkernel stylize_cartoon [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (straight x y 0) g (straight x y 1) b (straight x y 2)
          sr (saturate r g b saturation)
          sg (saturate g g b saturation)
          sb (saturate b g b saturation)
          q (clamp01 (/ (floor (* (channel c sr sg sb) levels)) levels))
          edge (max (abs (- (luminance (+ x 1) y) (luminance (- x 1) y)))
                    (abs (- (luminance x (+ y 1)) (luminance x (- y 1)))))
          dark (if (> edge edge_threshold) .2 1)]
      (finish (* q dark) (pixel x y 3) 0))))
