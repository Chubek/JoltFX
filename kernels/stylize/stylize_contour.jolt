;; @kernel       stylize_contour
;; @category     stylize
;; @description  Applies contour line effect.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.stylize; shared functions: common/image.jolt.
;; contour threshold; range [0, 1].
(param threshold 0.3 0 1 0)
;; line width in pixels; range [0.5, 16].
(param line_width 1 0.5 16 0)
;; line color red; range [0, 1].
(param color_r 0 0 1 0)
;; line color green; range [0, 1].
(param color_g 0 0 1 0)
;; line color blue; range [0, 1].
(param color_b 0 0 1 0)


(defkernel stylize_contour [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (ceil line_width)
          l (luminance x y)
          band (mod (* l 8) 1)
          edge (abs (- (mod (* (luminance (+ x r) y) 8) 1) band))
          m (if (< edge (* threshold .5)) 1 0)
          base (channel c (straight x y 0) (straight x y 1) (straight x y 2))]
      (finish (mix base (channel c color_r color_g color_b) m) (pixel x y 3) 0))))
