;; @kernel       stylize_ink_outline
;; @category     stylize
;; @description  Applies ink outline effect.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.stylize; shared functions: common/image.jolt.
;; edge threshold; range [0, 1].
(param threshold 0.2 0 1 0)
;; line width in pixels; range [0.5, 16].
(param line_width 2 0.5 16 0)
;; ink color red; range [0, 1].
(param color_r 0 0 1 0)
;; ink color green; range [0, 1].
(param color_g 0 0 1 0)
;; ink color blue; range [0, 1].
(param color_b 0 0 1 0)


(defkernel stylize_ink_outline [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (ceil line_width)
          edge (if (> r 0)
                 (max (abs (- (luminance (+ x r) y) (luminance (- x r) y)))
                      (abs (- (luminance x (+ y r)) (luminance x (- y r)))))
                 0)
          m (clamp01 (/ (- edge threshold) (max .0001 threshold)))
          base (channel c (straight x y 0) (straight x y 1) (straight x y 2))]
      (finish (mix base (channel c color_r color_g color_b) m) (pixel x y 3) 0))))
