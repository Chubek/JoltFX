;; @kernel       stylize_oil_paint
;; @category     stylize
;; @description  Applies oil painting effect.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.stylize; shared functions: common/image.jolt.
;; brush radius; range [1, 16].
(param radius 3 1 16 1)
;; effect intensity; range [0, 1].
(param intensity 0.5 0 1 0)
;; 0 sRGB, 1 linear; range [0, 1].
(param color_space 0 0 1 1)


(defkernel stylize_oil_paint [x y c]
  (if (= c 3) (pixel x y 3)
    (pixel x y c)))