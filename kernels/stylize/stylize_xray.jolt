;; @kernel       stylize_xray
;; @category     stylize
;; @description  Applies X-ray effect.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.stylize; shared functions: common/image.jolt.
;; intensity; range [0, 1].
(param intensity 0.8 0 1 0)
;; invert; range [0, 1].
(param invert 0 0 1 1)
;; color red; range [0, 1].
(param color_r 0.2 0 1 0)
;; color green; range [0, 1].
(param color_g 0.2 0 1 0)
;; color blue; range [0, 1].
(param color_b 0.8 0 1 0)


(defkernel stylize_xray [x y c]
  (if (= c 3) (pixel x y 3)
    (let [l (luminance x y)
          base (if (= invert 1) (- 1 l) l)
          edge (max (abs (- (luminance (+ x 1) y) (luminance (- x 1) y)))
                    (abs (- (luminance x (+ y 1)) (luminance x (- y 1)))))
          m (clamp01 (+ base (* edge 2)))
          tinted (* m (channel c color_r color_g color_b))]
      (finish (mix (channel c (straight x y 0) (straight x y 1) (straight x y 2)) tinted intensity) (pixel x y 3) 0))))
