;; @kernel       stylize_comic_book
;; @category     stylize
;; @description  Applies comic book effect.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.stylize; shared functions: common/image.jolt.
;; dot size in pixels; range [0.5, 16].
(param dot_size 4 0.5 16 0)
;; edge threshold; range [0, 1].
(param edge_threshold 0.2 0 1 0)
;; color reduction levels; range [2, 32].
(param color_reduction 4 2 32 1)


(defkernel stylize_comic_book [x y c]
  (if (= c 3) (pixel x y 3)
    (let [l (luminance x y)
          ds (max 1 dot_size)
          gx (mod x ds)
          gy (mod y ds)
          half (/ ds 2)
          d (sqrt (+ (* (- gx half) (- gx half)) (* (- gy half) (- gy half))))
          dot (if (< d (* half (clamp01 l))) 1 0)
          q (/ (floor (* (straight x y c) color_reduction)) color_reduction)
          edge (max (abs (- (luminance (+ x 1) y) (luminance (- x 1) y)))
                    (abs (- (luminance x (+ y 1)) (luminance x (- y 1)))))
          dark (if (> edge edge_threshold) .15 1)]
      (finish (* q dot dark) (pixel x y 3) 0))))
