;; @kernel       stylize_line_art
;; @category     stylize
;; @description  Applies line art effect.
;; @complexity   Medium
;; @gpu          Yes
;; @since        0.7.0
;; @author       joltfx-team
;; Execution: CPU image profile; @gpu describes parallel suitability, not dispatch support.
;; Input: image src (premultiplied RGBA); output: image dst, same dimensions.
;; Module: jolt.fx.kernels.stylize; shared functions: common/image.jolt.
;; edge threshold; range [0, 1].
(param edge_threshold 0.25 0 1 0)
;; line width in pixels; range [0.5, 16].
(param line_width 1 0.5 16 0)
;; line color red; range [0, 1].
(param color_r 0 0 1 0)
;; line color green; range [0, 1].
(param color_g 0 0 1 0)
;; line color blue; range [0, 1].
(param color_b 0 0 1 0)


(defkernel stylize_line_art [x y c]
  (if (= c 3) (pixel x y 3)
    (let [r (ceil line_width)
          gx (- (luminance (+ x r) y) (luminance (- x r) y))
          gy (- (luminance x (+ y r)) (luminance x (- y r)))
          edge (sqrt (+ (* gx gx) (* gy gy)))
          m (clamp01 (/ (- edge edge_threshold) (max .0001 edge_threshold)))
          paper (channel c 1 1 1)]
      (finish (mix paper (channel c color_r color_g color_b) m) (pixel x y 3) 0))))
