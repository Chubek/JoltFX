;; Executable Joltscript regression on a 4x4 coordinate ramp.
;; The C harness applies these named uniforms, then passes the rendered frame
;; to this assertion kernel. Defaults, transparency and further edge cases
;; are also covered by test_image_kernels.c.
(param bins 64 64 64 0)
(defkernel test_histogram_compute [x y c]
  (assert-pixel 0 0 3 1))
